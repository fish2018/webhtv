<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_shell_proxy_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ad_block_stats"
        android:textColor="@color/dialog_outlined_button_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/statsTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        app:tabGravity="fill"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Button"
        app:tabTextColor="@color/dialog_outlined_button_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/overviewPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ad_stats_overview"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/totalBlocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_block_total"
                            android:textColor="#5F6368"
                            android:textSize="14sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/aiFeedbackCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_feedback_count"
                            android:textColor="#5F6368"
                            android:textSize="14sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/aiSuccessRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_ai_success_rate"
                            android:textColor="#5F6368"
                            android:textSize="14sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/black_10" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/ad_site_overview"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/siteCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_site_count"
                            android:textColor="#5F6368"
                            android:textSize="14sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/topSite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="-"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_top_site"
                            android:textColor="#5F6368"
                            android:textSize="14sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/topSiteShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_top_site_share"
                            android:textColor="#5F6368"
                            android:textSize="14sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/sitePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/siteRankEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/siteRankRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/rulePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ruleRankEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ruleRankRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/pipelinePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/pipelineRankEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pipelineRankRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/logPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/logEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:visibility="gone" />
            <HorizontalScrollView
                android:id="@+id/logTableScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="false"
                android:overScrollMode="never">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@color/black_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_site_name"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_site_domain"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_playback_context"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="340dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_rule_domain"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_blocked_at"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_segment_start"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_segment_end"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_segment_duration"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dialog_outlined_button_text"
                android:textSize="13sp"
                android:text="@string/ad_log_pipeline"
                android:textStyle="bold" />
        </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/logRecycler"
                        android:layout_width="1660dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </HorizontalScrollView>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/chartPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/chartEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:visibility="gone" />
            <com.fongmi.android.tv.widget.AdBlockChartView
                android:id="@+id/chartView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black_10" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:minWidth="112dp"
            android:text="@string/ad_stats_reset"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="112dp"
            android:text="@android:string/cancel"
            android:textColor="@color/dialog_primary_button_text"
            android:textSize="14sp"
            app:backgroundTint="@color/dialog_primary_button_bg" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
