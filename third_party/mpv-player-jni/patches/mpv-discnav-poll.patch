+
+// Run on the demux owner, but do not read media or change queue demand. A
+// paused menu must finish authored animation even when all queues are full.
+static bool poll_nav(struct demux_internal *in)
+{
+    if (!in->nav_poll || in->blocked || demux_cancel_test(in->d_thread))
+        return false;
+    in->nav_poll = false;
+    mp_mutex_unlock(&in->lock);
+    stream_control(in->d_thread->stream, STREAM_CTRL_NAV_POLL, NULL);
+    mp_mutex_lock(&in->lock);
+    return true;
 }
 
