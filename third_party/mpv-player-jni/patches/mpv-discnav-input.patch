+// The libbluray logger is process-global and has no opaque owner. Never retain
+// a stream there: only a synchronous API call may lend it a thread-local owner.
+static thread_local struct {
+    stream_t *stream;
+    const char *phase;
+    uint32_t request;
+    unsigned lines;
+    int64_t window_ns;
+    unsigned window_lines;
+} bd_trace;
+
+static bool bluray_trace_line(const char *text, bool input)
+{
+    if (!text)
+        return false;
+    if (strncmp(text, "hdmv_vm.c:", 10) == 0)
+        return true;
+    if (strncmp(text, "graphics_controller.c:", 22) == 0) {
+        if (strstr(text, "skipping already rendered") ||
+            strstr(text, "not triggered (ANIMATING)"))
+            return false;
+        return strstr(text, "_set_button_page") || strstr(text, "_user_input") ||
+               strstr(text, "_mouse_move") || strstr(text, "auto-activate") ||
+               strstr(text, " activated") || strstr(text, "unknown page") ||
+               (input && (strstr(text, "render button #") ||
+                          strstr(text, "rendering page #")));
+    }
+    return strncmp(text, "bluray.c:", 9) == 0 &&
+           (strstr(text, "bd_menu_call") || strstr(text, "bd_user_input") ||
+            strstr(text, "bd_play_title") || strstr(text, "HDMV"));
+}
+
+static void bluray_trace_log(const char *text)
+{
+    if (!bd_trace.stream || !bluray_trace_line(text, !strcmp(bd_trace.phase, "input")))
+        return;
+    int64_t now = mp_time_ns();
+    if (now - bd_trace.window_ns >= MP_TIME_S_TO_NS(1)) {
+        bd_trace.window_ns = now;
+        bd_trace.window_lines = 0;
+    }
+    if (bd_trace.lines >= 96 || bd_trace.window_lines >= 600) {
+        if (bd_trace.lines == 96 || bd_trace.window_lines == 600) {
+            MP_INFO(bd_trace.stream, "bdnav-debug seq=%u phase=%s trace capped\n",
+                    bd_trace.request, bd_trace.phase);
+            bd_trace.lines++;
+            bd_trace.window_lines++;
+        }
+        return;
+    }
+    bd_trace.lines++;
+    bd_trace.window_lines++;
+    MP_INFO(bd_trace.stream, "bdnav-debug seq=%u phase=%s t_ms=%lld %.900s",
+            bd_trace.request, bd_trace.phase, (long long)(now / 1000000), text);
+}
+
+static void bluray_trace_init(void)
+{
+    bd_set_debug_handler(bluray_trace_log);
+    bd_set_debug_mask(DBG_CRIT | DBG_HDMV | DBG_GC);
+}
+
+static void bluray_trace_begin(stream_t *s, const char *phase)
+{
+    struct bluray_priv_s *b = s->priv;
+    if (!b->trace_navigation)
+        return;
+    mp_mutex_lock(&b->overlay_lock);
+    bd_trace.request = b->trace_request;
+    mp_mutex_unlock(&b->overlay_lock);
+    bd_trace.stream = s;
+    bd_trace.phase = phase;
+    bd_trace.lines = 0;
+}
+
+static void bluray_trace_end(void)
+{
+    bd_trace.stream = NULL;
+}
+
+static void bluray_trace_state(stream_t *s, const char *phase, int result,
+                               int64_t started_ns)
+{
+    struct bluray_priv_s *b = s->priv;
+    if (!b->trace_navigation)
+        return;
+    mp_mutex_lock(&b->overlay_lock);
+    MP_INFO(s, "bdnav-debug seq=%u phase=%s result=%d elapsed_ms=%lld "
+               "menu=%d overlay=%d popup=%d still=%d uo=%u change=%u disc=%u "
+               "plane=%dx%d delivered=%d\n",
+            b->trace_request, phase, result,
+            (long long)((mp_time_ns() - started_ns) / 1000000),
+            b->menu_event_active, b->overlay_ig_visible, b->popup_supported,
+            b->still_active, b->uo_mask, b->nav_change_id, b->discontinuity_id,
+            b->plane_w, b->plane_h, b->data_delivered);
+    mp_mutex_unlock(&b->overlay_lock);
+}
+
+static int bluray_read_ext(stream_t *s, void *buf, int len, BD_EVENT *event)
+{
+    struct bluray_priv_s *b = s->priv;
+    bluray_trace_begin(s, len ? "read" : "poll");
+    int result = bd_read_ext(b->bd, buf, len, event);
+    bluray_trace_end();
+    return result;
+}
 
