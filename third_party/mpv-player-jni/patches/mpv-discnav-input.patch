+static int bluray_call_user_menu(stream_t *s)
+{
+    struct bluray_priv_s *b = s->priv;
+    int64_t call_started = mp_time_ns();
+    int result = bd_menu_call(b->bd, -1);
+    bluray_trace_state(s, "menu-normal", result, call_started);
+    if (result > 0)
+        return result;
+
+    mp_mutex_lock(&b->overlay_lock);
+    bool restricted = b->uo_mask & BLURAY_UO_MENU_CALL;
+    bool started = b->data_delivered;
+    mp_mutex_unlock(&b->overlay_lock);
+    // Only an explicit user request may override an authored menu-call mask.
+    // Never do this while opening the disc: FIRST PLAY must run first.
+    if (!restricted || !started ||
+        !bd_set_player_setting(b->bd, BLURAY_PLAYER_SETTING_UO_RESTRICTION_LEVEL,
+                               BLURAY_PLAYER_SETTING_UO_RESTRICTION_DISABLED))
+        return result;
+
+    call_started = mp_time_ns();
+    result = bd_menu_call(b->bd, -1);
+    bluray_trace_state(s, "menu-override", result, call_started);
+    // This instance otherwise uses libbluray's default RELAXED policy. Do not
+    // leave title search, seeking or subsequent input globally unrestricted.
+    bd_set_player_setting(b->bd, BLURAY_PLAYER_SETTING_UO_RESTRICTION_LEVEL,
+                          BLURAY_PLAYER_SETTING_UO_RESTRICTION_RELAXED);
+    MP_INFO(s, "discnav explicit menu override result=%d\n", result);
+    return result;
 }
 
