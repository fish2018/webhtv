+/* WebHTV authored-menu routing. Never synthesize a page/register write. */
+static const MENU_PARENT *_visited_parent(GRAPHICS_CONTROLLER *gc, BD_IG_PAGE *page)
+{
+    if (!gc->menu_history_count) return NULL;
+    const MENU_PARENT *visit = &gc->menu_history[gc->menu_history_count - 1];
+    BD_IG_PAGE *parent = _find_page(&gc->igs->ics->interactive_composition, visit->page);
+    if (!parent || visit->child != page->id || visit->child_version != page->version ||
+        visit->page_version != parent->version || visit->num_bogs != parent->num_bogs ||
+        visit->num_bogs > MAX_NUM_BOGS) return NULL;
+    return visit;
+}
+
+static BD_IG_BUTTON *_visited_button_at(GRAPHICS_CONTROLLER *gc, BD_IG_PAGE *parent,
+                                        const MENU_PARENT *visit)
+{
+    BD_IG_BUTTON *hit = NULL;
+    for (unsigned i = 0; i < visit->num_bogs; i++) {
+        BD_IG_BUTTON *button = _find_button_bog(&parent->bog[i], visit->enabled[i]);
+        if (!button || button->auto_action_flag || _button_has_no_action(button)) continue;
+        BD_PG_OBJECT *object = _find_object_for_button(gc->igs, button, BTN_SELECTED, NULL);
+        if (!object || gc->mouse_x < button->x_pos || gc->mouse_y < button->y_pos ||
+            gc->mouse_x >= button->x_pos + object->width ||
+            gc->mouse_y >= button->y_pos + object->height) continue;
+        if (hit) return NULL; /* overlapping parent targets must not be guessed */
+        hit = button;
+    }
+    return hit;
+}
+
+static int _inert_pointer_button(const BD_IG_BUTTON *button)
+{
+    if (!_button_has_no_action(button) || button->auto_action_flag) return 0;
+    uint16_t refs[] = {button->upper_button_id_ref, button->lower_button_id_ref,
+                       button->left_button_id_ref, button->right_button_id_ref};
+    for (unsigned i = 0; i < 4; i++) {
+        if (refs[i] != button->id && refs[i] != 0xffff) return 0;
+    }
+    return 1;
+}
+
+static BD_IG_BUTTON *_matching_parent_button(BD_IG_PAGE *page, const BD_IG_BUTTON *copy)
+{
+    if (!_inert_pointer_button(copy) || copy->selected_start_object_id_ref == 0xffff) return NULL;
+    for (unsigned i = 0; i < page->num_bogs; i++) {
+        BD_IG_BUTTON *button = _find_button_bog(&page->bog[i], page->bog[i].default_valid_button_id_ref);
+        if (button && button->num_nav_cmds && !button->auto_action_flag &&
+            button->x_pos == copy->x_pos && button->y_pos == copy->y_pos &&
+            button->selected_start_object_id_ref == copy->selected_start_object_id_ref)
+            return button;
+    }
+    return NULL;
+}
+
+/* Some discs flatten the parent toolbar into an inert, cropped bitmap. Match
+ * multiple parent button centers, not their padded image edges. Both the actual
+ * pointer and target center must lie in the backdrop; ambiguous hits fail. */
+static unsigned _parent_buttons_in_background(GRAPHICS_CONTROLLER *gc, BD_IG_PAGE *parent,
+                                               const BD_IG_BUTTON *background, BD_IG_BUTTON **target)
+{
+    *target = NULL;
+    if (!_button_has_no_action(background) || background->auto_action_flag) return 0;
+    BD_PG_OBJECT *area = _find_object_for_button(gc->igs, background, BTN_SELECTED, NULL);
+    if (!area) return 0;
+    unsigned count = 0, hits = 0;
+    for (unsigned i = 0; i < parent->num_bogs; i++) {
+        BD_IG_BUTTON *button = _find_button_bog(&parent->bog[i], parent->bog[i].default_valid_button_id_ref);
+        if (!button || !button->nav_cmds || _button_has_no_action(button) || button->auto_action_flag) continue;
+        BD_PG_OBJECT *object = _find_object_for_button(gc->igs, button, BTN_SELECTED, NULL);
+        if (!object || !object->width || !object->height) continue;
+        unsigned cx = button->x_pos + object->width / 2;
+        unsigned cy = button->y_pos + object->height / 2;
+        if (cx < background->x_pos || cy < background->y_pos ||
+            cx >= background->x_pos + area->width || cy >= background->y_pos + area->height) continue;
+        count++;
+        if (gc->mouse_x >= button->x_pos && gc->mouse_y >= button->y_pos &&
+            gc->mouse_x < button->x_pos + object->width && gc->mouse_y < button->y_pos + object->height) {
+            hits++;
+            *target = button;
+        }
+    }
+    if (count < 2 || hits != 1) *target = NULL;
+    return count;
+}
+
+/* Resolve only constant GPR preparation inside this button's own straight-line
+ * program. Preserve SetButtonPage flag bits exactly as the real HDMV VM does. */
+static int _menu_constant_operand(const MOBJ_CMD *commands, unsigned end, uint32_t operand,
+                                  int immediate, uint32_t *value)
+{
+    if (immediate) { *value = operand; return 1; }
+    while (end) {
+        const MOBJ_CMD *cmd = &commands[--end];
+        if (cmd->insn.grp == INSN_GROUP_SET && cmd->insn.sub_grp == SET_SET &&
+            cmd->insn.set_opt == INSN_MOVE && cmd->dst == (operand & 0xfff)) {
+            *value = (operand & 0xc0000000) | (cmd->src & 0x3fffffff);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int _authored_return_page(const BD_IG_BUTTON *button)
+{
+    if (!button || !button->auto_action_flag || !button->num_nav_cmds || button->num_nav_cmds > 16 || !button->nav_cmds ||
+        button->normal_start_object_id_ref != 0xffff ||
+        button->selected_start_object_id_ref != 0xffff ||
+        button->activated_start_object_id_ref != 0xffff) return -1;
+    int page = -1;
+    for (unsigned i = 0; i < button->num_nav_cmds; i++) {
+        const MOBJ_CMD *cmd = &button->nav_cmds[i];
+        const HDMV_INSN *insn = &cmd->insn;
+        if (insn->grp == INSN_GROUP_BRANCH && insn->sub_grp == BRANCH_GOTO && insn->branch_opt == INSN_NOP) continue;
+        if (page >= 0 || insn->grp != INSN_GROUP_SET || insn->op_cnt != 2) return -1;
+        if (insn->sub_grp == SET_SET && insn->set_opt == INSN_MOVE &&
+            !insn->imm_op1 && insn->imm_op2 && cmd->dst <= 0xfff) continue;
+        uint32_t dst, src;
+        if (insn->sub_grp != SET_SETSYSTEM || insn->set_opt != INSN_SET_BUTTON_PAGE ||
+            !_menu_constant_operand(button->nav_cmds, i, cmd->dst, insn->imm_op1, &dst) ||
+            !_menu_constant_operand(button->nav_cmds, i, cmd->src, insn->imm_op2, &src) || !(src & 0x80000000)) return -1;
+        /* Reject unrelated register writes, even if the page itself is known. */
+        for (unsigned j = 0; j < i; j++) {
+            const MOBJ_CMD *move = &button->nav_cmds[j];
+            if (move->insn.grp == INSN_GROUP_SET &&
+                (insn->imm_op1 || move->dst != (cmd->dst & 0xfff)) &&
+                (insn->imm_op2 || move->dst != (cmd->src & 0xfff))) return -1;
+        }
+        page = src & 0xff;
+    }
+    return page;
+}

+static int _menu_only_auto(const BD_IG_BUTTON *button, unsigned page_id)
+{
+    if (!button->auto_action_flag || !button->num_nav_cmds || !button->nav_cmds ||
+        button->normal_start_object_id_ref != 0xffff ||
+        button->selected_start_object_id_ref != 0xffff ||
+        button->activated_start_object_id_ref != 0xffff) return 0;
+    int selects = 0;
+    for (unsigned i = 0; i < button->num_nav_cmds; i++) {
+        const MOBJ_CMD *cmd = &button->nav_cmds[i];
+        if (cmd->insn.grp == INSN_GROUP_CMP) continue;
+        if (cmd->insn.grp != INSN_GROUP_SET || cmd->insn.sub_grp != SET_SETSYSTEM || !cmd->insn.imm_op1) return 0;
+        if (cmd->insn.set_opt == INSN_ENABLE_BUTTON || cmd->insn.set_opt == INSN_DISABLE_BUTTON) continue;
+        if (cmd->insn.set_opt != INSN_SET_BUTTON_PAGE || !cmd->insn.imm_op2 ||
+            !(cmd->dst & 0x80000000) || ((cmd->src & 0x80000000) && (cmd->src & 0xff) != page_id)) return 0;
+        selects = 1;
+    }
+    return selects;
+}
+
+typedef struct {
+    BD_IG_BUTTON *button;
+    BD_IG_BUTTON *first_auto;
+} MENU_ROUTE_NODE;
+
+static int _queue_menu_node(MENU_ROUTE_NODE queue[MAX_NUM_BOGS], unsigned *tail,
+                            BD_IG_BUTTON *button, BD_IG_BUTTON *first_auto)
+{
+    if (!button) return 1;
+    for (unsigned i = 0; i < *tail; i++) if (queue[i].button == button) return 1;
+    if (*tail == MAX_NUM_BOGS) return 0;
+    queue[(*tail)++] = (MENU_ROUTE_NODE){button, first_auto};
+    return 1;
+}
+
+static BD_IG_BUTTON *_find_authored_return(GRAPHICS_CONTROLLER *gc, BD_IG_PAGE *page,
+                                          const BD_IG_BUTTON *copy, BD_IG_PAGE **parent,
+                                          BD_IG_BUTTON **target)
+{
+    MENU_ROUTE_NODE queue[MAX_NUM_BOGS];
+    unsigned head = 0, tail = 0, first = 0;
+    BD_IG_BUTTON *found = NULL;
+    *parent = NULL;
+    *target = NULL;
+    if (!page->num_bogs || page->num_bogs > MAX_NUM_BOGS) return NULL;
+    const MENU_PARENT *visit = _visited_parent(gc, page);
+    unsigned selected = bd_psr_read(gc->regs, PSR_SELECTED_BUTTON_ID);
+    BD_IG_BUTTON *start = _find_button_page(page, selected, &first);
+    if (!start || _inert_pointer_button(start) || gc->bog_data[first].enabled_button != selected) {
+        selected = page->default_selected_button_id_ref;
+        start = _find_button_page(page, selected, &first);
+    }
+    if (!start || _inert_pointer_button(start) || gc->bog_data[first].enabled_button != selected) return NULL;
+    _queue_menu_node(queue, &tail, start, NULL);
+    while (head < tail) {
+        MENU_ROUTE_NODE node = queue[head++];
+        BD_IG_BUTTON *button = node.button;
+        int page_id = _authored_return_page(button);
+        BD_IG_PAGE *candidate = page_id >= 0 ? _find_page(&gc->igs->ics->interactive_composition, page_id) : NULL;
+        if (candidate && candidate != page && candidate->num_bogs <= MAX_NUM_BOGS) {
+            BD_IG_BUTTON *match = copy ? _matching_parent_button(candidate, copy) : NULL;
+            if (copy && !match) _parent_buttons_in_background(gc, candidate, copy, &match);
+            unsigned copies = 0;
+            if (!copy) {
+                for (unsigned i = 0; i < page->num_bogs; i++) {
+                    BD_IG_BUTTON *b = _find_button_bog(&page->bog[i], gc->bog_data[i].enabled_button);
+                    copies += _matching_parent_button(candidate, b) != NULL;
+                    BD_IG_BUTTON *unused;
+                    if (_parent_buttons_in_background(gc, candidate, b, &unused) >= 2) copies += 2;
+                }
+            }
+            if (!copy && visit && candidate->id == visit->page) {
+                if (gc->mouse_parent_position) match = _visited_button_at(gc, candidate, visit);
+                else copies = 2; /* an observed entry plus authored return proves parenthood */
+            }
+            if (gc->mouse_parent_position && (!visit || candidate->id != visit->page || !match)) continue;
+            if (match || copies >= 2) {
+                if (found && *parent != candidate) return NULL; /* ambiguous parent */
+                if (!found) { found = node.first_auto ? node.first_auto : button; *parent = candidate; *target = match; }
+            }
+        }
+        /* Menu-only auto nodes may choose an enabled variant using PSRs.
+         * Explore their possible same-page destinations, but execute only the
+         * first auto node, then re-evaluate the graph after the real VM ends. */
+        if (button->auto_action_flag) {
+            if (_menu_only_auto(button, page->id)) {
+                for (unsigned i = 0; i < button->num_nav_cmds; i++) {
+                    const MOBJ_CMD *cmd = &button->nav_cmds[i];
+                    if (cmd->insn.grp == INSN_GROUP_SET && cmd->insn.set_opt == INSN_SET_BUTTON_PAGE &&
+                        !_queue_menu_node(queue, &tail, _find_button_page(page, cmd->dst & 0xffff, NULL),
+                                          node.first_auto ? node.first_auto : button)) return NULL;
+                }
+            }
+            continue;
+        }
+        uint16_t refs[] = {button->upper_button_id_ref, button->lower_button_id_ref,
+                           button->left_button_id_ref, button->right_button_id_ref};
+        for (unsigned i = 0; i < 4; i++) {
+            unsigned next = 0;
+            BD_IG_BUTTON *b = _find_button_page(page, refs[i], &next);
+            if (b && next < page->num_bogs && (node.first_auto || gc->bog_data[next].enabled_button == refs[i]) &&
+                !_queue_menu_node(queue, &tail, b, node.first_auto)) return NULL;
+        }
+    }
+    return found;
+}
+
+static int _request_authored_return(GRAPHICS_CONTROLLER *gc, BD_IG_PAGE *page,
+                                    const BD_IG_BUTTON *copy, GC_NAV_CMDS *cmds)
+{
+    BD_IG_PAGE *parent;
+    BD_IG_BUTTON *target;
+    BD_IG_BUTTON *gateway = _find_authored_return(gc, page, copy, &parent, &target);
+    if (!gateway || !cmds) return 0;
+    GC_TRACE("_user_input authored-return: page=%u gateway=%u parent=%u target=%d\n",
+             page->id, gateway->id, parent->id, target ? target->id : -1);
+    gc->pointer_route_pending = 1;
+    gc->pointer_target_page = parent->id;
+    gc->pointer_target_button = target ? target->id : 0xffff;
+    const MENU_PARENT *visit = _visited_parent(gc, page);
+    gc->pointer_origin_button = visit && visit->page == parent->id ? visit->entry : 0xffff;
+    gc->pointer_route_steps = 1;
+    gc->pointer_route_deadline = bd_get_scr() + 180000;
+    _select_button(gc, gateway->id);
+    _render_page(gc, 0xffff, cmds);
+    return 1;
+}
+
+static int _complete_pointer_route(GRAPHICS_CONTROLLER *gc, GC_NAV_CMDS *cmds)
+{
+    if (!gc->pointer_route_pending || !cmds || cmds->num_nav_cmds) return 0;
+    if (bd_get_scr() > gc->pointer_route_deadline) {
