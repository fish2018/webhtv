+/* WebHTV observed menu transitions. Only an actual input can create a parent. */
+static void _clear_menu_history(GRAPHICS_CONTROLLER *gc)
+{
+    gc->menu_history_count = 0;
+    gc->menu_entry_pending = 0;
+    gc->mouse_parent_position = 0;
+    gc->valid_mouse_position = 0;
+    gc->pointer_route_pending = 0;
+}
+
+static void _remember_menu_entry(GRAPHICS_CONTROLLER *gc, BD_IG_PAGE *page,
+                                  const BD_IG_BUTTON *button)
+{
+    gc->menu_entry_pending = 0;
+    if (!button || button->auto_action_flag || !button->num_nav_cmds ||
+        !button->nav_cmds || !gc->ig_drawn || page->num_bogs > MAX_NUM_BOGS ||
+        !_find_object_for_button(gc->igs, button, BTN_SELECTED, NULL)) return;
+    gc->menu_entry_page = page->id;
+    gc->menu_entry_button = button->id;
+    gc->menu_entry_deadline = bd_get_scr() + 180000;
+    gc->menu_entry_pending = 1;
+}
+
+static void _observe_menu_page_change(GRAPHICS_CONTROLLER *gc, uint16_t page_id)
+{
+    unsigned current = bd_psr_read(gc->regs, PSR_MENU_PAGE_ID);
+    if (current == page_id) return;
+    gc->mouse_parent_position = 0;
+    for (unsigned i = 0; i < gc->menu_history_count; i++) {
+        if (gc->menu_history[i].page == page_id) {
+            gc->menu_history_count = i; /* authored return: pop, never reverse the edge */
+            gc->menu_entry_pending = 0;
+            return;
+        }
+    }
+    BD_IG_PAGE *page = _find_page(&gc->igs->ics->interactive_composition, current);
+    BD_IG_PAGE *child = _find_page(&gc->igs->ics->interactive_composition, page_id);
+    unsigned bog = 0;
+    BD_IG_BUTTON *entry = page ? _find_button_page(page, gc->menu_entry_button, &bog) : NULL;
+    if (!gc->menu_entry_pending || current != gc->menu_entry_page ||
+        bd_get_scr() > gc->menu_entry_deadline || !page || !child || !entry ||
+        page->num_bogs > MAX_NUM_BOGS || bog >= MAX_NUM_BOGS ||
+        gc->bog_data[bog].enabled_button != entry->id) {
+        gc->menu_history_count = 0; /* unrelated/automatic transition, not a guessed parent */
+        gc->menu_entry_pending = 0;
+        return;
+    }
+    if (gc->menu_history_count &&
+        gc->menu_history[gc->menu_history_count - 1].child != current) gc->menu_history_count = 0;
+    if (gc->menu_history_count == MENU_HISTORY_MAX) {
+        memmove(gc->menu_history, gc->menu_history + 1,
+                (MENU_HISTORY_MAX - 1) * sizeof(gc->menu_history[0]));
+        gc->menu_history_count--;
+    }
+    MENU_PARENT *visit = &gc->menu_history[gc->menu_history_count++];
+    visit->page = page->id;
+    visit->child = child->id;
+    visit->entry = entry->id;
+    visit->page_version = page->version;
+    visit->child_version = child->version;
+    visit->num_bogs = page->num_bogs;
+    for (unsigned i = 0; i < page->num_bogs; i++) visit->enabled[i] = gc->bog_data[i].enabled_button;
+    gc->menu_entry_pending = 0;
+    GC_TRACE("_user_input menu-visit: parent=%u child=%u entry=%u depth=%u\n",
+             visit->page, visit->child, visit->entry, gc->menu_history_count);
+}
+/* End WebHTV observed menu transitions. */
