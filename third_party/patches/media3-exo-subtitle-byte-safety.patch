+package androidx.media3.exoplayer.text;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import androidx.media3.common.Format;
+import androidx.media3.common.util.Consumer;
+import androidx.media3.extractor.text.CuesWithTiming;
+import androidx.media3.extractor.text.SubtitleParser;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import java.nio.charset.Charset;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.concurrent.atomic.AtomicReference;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+/** Tests charset conversion boundaries in {@link DelegatingSubtitleDecoder}. */
+@RunWith(AndroidJUnit4.class)
+public final class DelegatingSubtitleDecoderCharsetTest {
+
+  @Test
+  public void decode_nonUtfTextWithUnusedBufferTail_convertsOnlyValidBytes() {
+    String subtitleText =
+        "1\n00:00:00,000 --> 00:00:01,000\n"
+            + "这是用于检测字幕字符集的中文文本，这是用于检测字幕字符集的中文文本。\n";
+    byte[] validBytes = subtitleText.getBytes(Charset.forName("GB18030"));
+    byte[] decoderBuffer = Arrays.copyOf(validBytes, validBytes.length + 64);
+    Arrays.fill(decoderBuffer, validBytes.length, decoderBuffer.length, (byte) 0x7F);
+    CapturingSubtitleParser parser = new CapturingSubtitleParser();
+    DelegatingSubtitleDecoder decoder =
+        new DelegatingSubtitleDecoder("CharsetDecoder", parser, /* detectCharset= */ true);
+
+    decoder.decode(decoderBuffer, validBytes.length, /* reset= */ false);
+
+    assertThat(new String(parser.data.get(), StandardCharsets.UTF_8)).isEqualTo(subtitleText);
+  }
+
+  @Test
+  public void decode_nonUtfTtml_updatesXmlEncodingDeclaration() {
+    String ttml =
+        "<?xml version='1.0' encoding='GB18030'?>"
+            + "<tt><body><div><p begin='0s' end='1s'>"
+            + "这是用于检测字幕字符集的中文文本，这是用于检测字幕字符集的中文文本。"
+            + "</p></div></body></tt>";
+    byte[] bytes = ttml.getBytes(Charset.forName("GB18030"));
+    CapturingSubtitleParser parser = new CapturingSubtitleParser();
+    DelegatingSubtitleDecoder decoder =
+        new DelegatingSubtitleDecoder(
+            "TtmlCharsetDecoder",
+            parser,
+            /* detectCharset= */ true,
+            /* inputIsTtml= */ true);
+
+    decoder.decode(bytes, bytes.length, /* reset= */ false);
+
+    String converted = new String(parser.data.get(), StandardCharsets.UTF_8);
+    assertThat(converted).contains("encoding='UTF-8'");
+    assertThat(converted).contains("这是用于检测字幕字符集的中文文本");
+  }
+
+  @Test
+  public void decode_detectionDisabled_preservesBinaryBytesAndValidLength() {
+    byte[] validBytes = new byte[] {0, 3, (byte) 0xFF, 1, 2};
+    byte[] decoderBuffer = Arrays.copyOf(validBytes, validBytes.length + 8);
+    CapturingSubtitleParser parser = new CapturingSubtitleParser();
+    DelegatingSubtitleDecoder decoder =
+        new DelegatingSubtitleDecoder("BinaryDecoder", parser, /* detectCharset= */ false);
+
+    decoder.decode(decoderBuffer, validBytes.length, /* reset= */ false);
+
+    assertThat(parser.data.get()).isEqualTo(validBytes);
+  }
+
+  private static final class CapturingSubtitleParser implements SubtitleParser {
+    private final AtomicReference<byte[]> data = new AtomicReference<>();
+
+    @Override
+    public void parse(
+        byte[] data,
+        int offset,
+        int length,
+        OutputOptions outputOptions,
+        Consumer<CuesWithTiming> output) {
+      this.data.set(Arrays.copyOfRange(data, offset, offset + length));
+    }
+
+    @Override
+    public @Format.CueReplacementBehavior int getCueReplacementBehavior() {
+      return Format.CUE_REPLACEMENT_BEHAVIOR_MERGE;
+    }
+  }
+}
