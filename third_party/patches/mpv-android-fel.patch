+                ctx->force_swdec ? "EL" : "BL", ctx->fel_decoded,
+                ctx->fel_send_calls, ctx->fel_receive_calls,
+                (long long)(ctx->fel_send_ns / 1000),
+                (long long)(ctx->fel_receive_ns / 1000),
+                (long long)(ctx->fel_call_max_ns / 1000), result);
