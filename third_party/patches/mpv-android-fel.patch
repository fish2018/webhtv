+        int candidate = (next + n) % p->output_count;
+        if (output_has_live_fel_frame(p, &p->outputs[candidate]))
+            continue;
+        if (!p->outputs[candidate].pending)
+            return candidate;
+        if (*waiting < 0)
+            *waiting = candidate;
+    }
+    return -1;
 }

