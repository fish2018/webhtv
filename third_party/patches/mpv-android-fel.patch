+        p->fel_stage_started = 0;
+        p->fel_staged++;
+        p->fel_stage_ns += elapsed;
+        p->fel_stage_max_ns = MPMAX(p->fel_stage_max_ns, elapsed);
+        double now = mp_time_sec();
