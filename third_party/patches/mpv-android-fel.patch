+    // Returning to the existing decoder dispatch allows stop/reset to cancel
+    // without waiting for VO initialization or a GPU fence. The VO owns the
+    // phase-aware deadline; a second wall-clock deadline here is incorrect.
+    if (!p->fel_stage_started)
+        p->fel_stage_started = mp_time_ns();
+    int result = vo_prepare_fel_frame(vo, image);
+    if (result == VO_NOTIMPL) {
+        p->fel_stage_started = 0;
+        return VO_TRUE; // Existing non-staging (e.g. OpenGL) path.
+    }
+    if (result == VO_TRUE && image->android_fel_staging &&
+        mp_android_fel_staging_ready(image->android_fel_staging->data))
+    {
