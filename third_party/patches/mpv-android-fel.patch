+static void cancel_fel_prepare(struct vo *vo)
+{
+    struct vo_internal *in = vo->in;
+    mp_image_unrefp(&in->fel_prepare_image);
+    in->fel_prepare_generation++;
+    in->fel_prepare_result = VO_FALSE;
+    in->fel_prepare_started = in->fel_prepare_retry = 0;
+    in->fel_prepare_phase_started = 0;
+    in->fel_prepare_phase = 0;
