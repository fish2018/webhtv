+    struct fel_order_event fel_order[FEL_ORDER_CAPACITY], fel_last_pts_difference;
+    double fel_active_pts;
+    int fel_active_input, fel_active_output;
+    int64_t fel_slow_window;
+    unsigned fel_slow_count;
+    int64_t fel_wait_sample_at;
+    int fel_sched_disabled_error, fel_acquire_fence;
+    VkFence fel_probe_drains[8];
+    unsigned fel_probe_drain_count;
+    bool fel_probe_drain_failed;
 };
+
+static int output_sample_depth(VkFormat format);
+
+// Reuse already measured warm timings. No extra clocks, allocation or sampling
+// when profiling is off; sorting only happens at the existing log interval.
+static void fel_latency_add(struct fel_latency_window *window, uint64_t ns)
+{
+    window->ns[window->next] = ns;
+    window->next = (window->next + 1) % FEL_LATENCY_SAMPLES;
+    window->count = MPMIN(window->count + 1, FEL_LATENCY_SAMPLES);
+}
+
+static int fel_latency_compare(const void *a, const void *b)
+{
+    uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b;
+    return (x > y) - (x < y);
+}
+
+static void fel_latency_summary(const struct fel_latency_window *window,
+                                 uint64_t summary[3])
+{
+    summary[0] = summary[1] = summary[2] = 0;
+    if (!window->count)
+        return;
+    uint64_t sorted[FEL_LATENCY_SAMPLES];
+    memcpy(sorted, window->ns, window->count * sizeof(sorted[0]));
+    qsort(sorted, window->count, sizeof(sorted[0]), fel_latency_compare);
+    // Nearest-rank p50/p95 and maximum of the last <=128 measured calls.
+    summary[0] = sorted[(window->count * 50 + 99) / 100 - 1] / 1000;
+    summary[1] = sorted[(window->count * 95 + 99) / 100 - 1] / 1000;
+    summary[2] = sorted[window->count - 1] / 1000;
+}
+
+static struct fel_api_clock fel_api_begin(struct aimagereader_vk_stable *p)
+{
+    if (!p->fel_profile || !p->fel_profile_warm)
+        return (struct fel_api_clock){0};
+    return (struct fel_api_clock){mp_time_ns(), mp_fel_thread_cpu_ns()};
+}
+
+// Linux schedstat: running ns, runnable-but-not-running ns, timeslices.
+// All zero means accounting is disabled, not proof of zero scheduling delay.
+static int fel_parse_schedstat(const char *text, struct fel_wait_snapshot *s)
+{
+    uint64_t values[3];
+    for (int n = 0; n < 3; n++) {
+        while (*text == ' ' || *text == '\t' || *text == '\n')
+            text++;
+        if (*text < '0' || *text > '9')
+            return EINVAL;
+        char *end;
+        errno = 0;
+        values[n] = strtoull(text, &end, 10);
+        if (errno == ERANGE)
+            return EOVERFLOW;
+        text = end;
+        if (n < 2 && *text != ' ' && *text != '\t' && *text != '\n')
+            return EINVAL;
+    }
+    while (*text == ' ' || *text == '\t' || *text == '\n')
+        text++;
+    if (*text)
+        return EINVAL;
+    if (!values[0] && !values[1] && !values[2])
+        return ENODATA;
+    s->runtime = values[0];
+    s->runqueue = values[1];
+    s->slices = values[2];
+    return 0;
+}
+
+static int fel_read_schedstat(struct fel_wait_snapshot *s)
+{
+    char path[80], text[160];
+    snprintf(path, sizeof(path), "/proc/self/task/%ld/schedstat", (long)gettid());
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return errno;
+    ssize_t size = read(fd, text, sizeof(text) - 1);
+    int error = size < 0 ? errno : 0;
+    close(fd);
+    if (error)
+        return error;
+    if (size <= 0 || (size_t)size == sizeof(text) - 1)
+        return EINVAL;
+    text[size] = '\0';
+    return fel_parse_schedstat(text, s);
+}
+
+// Inspect the sync fd without consuming, importing, closing or waiting on it.
+// 0=no fence, 1=pending, 2=ready, negative=errno/invalid poll result.
+static int fel_probe_acquire_fence(int fd)
+{
+    if (fd < 0)
+        return 0;
+    struct pollfd state = {.fd = fd, .events = POLLIN};
+    int ret = poll(&state, 1, 0);
+    if (ret < 0)
+        return -errno;
+    if (!ret)
+        return 1;
+    if (state.revents & (POLLERR | POLLNVAL))
+        return -EINVAL;
+    return state.revents & POLLIN ? 2 : -EIO;
+}
+
+static struct fel_wait_snapshot fel_wait_snapshot(struct aimagereader_vk_stable *p)
+{
+    int saved_errno = errno;
+    struct fel_wait_snapshot s = {0};
+    s.sched_error = p->fel_sched_disabled_error;
+    if (!s.sched_error) {
+        s.sched_error = fel_read_schedstat(&s);
+        // Do not repeatedly probe a denied/missing kernel interface.
+        if (s.sched_error == EACCES || s.sched_error == EPERM ||
+            s.sched_error == ENOENT || s.sched_error == ENODATA)
+            p->fel_sched_disabled_error = s.sched_error;
+    }
+    struct rusage usage;
+    if (getrusage(RUSAGE_THREAD, &usage) < 0) {
+        s.usage_error = errno;
+    } else if (usage.ru_nvcsw < 0 || usage.ru_nivcsw < 0) {
+        s.usage_error = EOVERFLOW;
+    } else {
+        s.voluntary = usage.ru_nvcsw;
+        s.involuntary = usage.ru_nivcsw;
+    }
+    s.acquire = fel_probe_acquire_fence(p->fel_acquire_fence);
+    errno = saved_errno;
+    return s;
+}
+
+static int64_t fel_wait_delta(uint64_t before, uint64_t after, bool available)
+{
+    if (!available || after < before || after - before > INT64_MAX)
+        return -1;
+    return after - before;
+}
+
+static struct fel_wait_sample fel_wait_probe_begin(struct aimagereader_vk_stable *p)
+{
+    struct fel_wait_sample sample = {0};
+    if (!p->android_fel || !p->fel_profile || !p->fel_profile_warm ||
+        !mp_msg_test(p->log, MSGL_INFO))
+        return sample;
+    int64_t now = mp_time_ns();
+    if (p->fel_wait_sample_at > 0 && now >= p->fel_wait_sample_at &&
+        now - p->fel_wait_sample_at < MP_TIME_MS_TO_NS(3000))
+        return sample;
+    p->fel_wait_sample_at = now;
+    sample.active = true;
+    sample.before = fel_wait_snapshot(p);
+    sample.probe_ns = MPMAX(0, mp_time_ns() - now);
+    sample.clock = fel_api_begin(p);
+    return sample;
+}
+
+static void fel_wait_probe_end(struct aimagereader_vk_stable *p,
+                               const struct fel_wait_sample *sample)
+{
+    if (!sample->active)
+        return;
+    int64_t now = mp_time_ns();
+    int64_t cpu = mp_fel_thread_cpu_ns();
+    struct fel_wait_snapshot after = fel_wait_snapshot(p);
+    const struct fel_wait_snapshot *before = &sample->before;
+    int64_t probe_ns = sample->probe_ns + MPMAX(0, mp_time_ns() - now);
+    bool sched = !before->sched_error && !after.sched_error &&
+        after.runtime >= before->runtime && after.slices >= before->slices;
+    bool usage = !before->usage_error && !after.usage_error;
+    int64_t runqueue = fel_wait_delta(before->runqueue, after.runqueue, sched);
+    int64_t running = fel_wait_delta(before->runtime, after.runtime, sched);
+    // Do not turn wall-cpu-runqueue into a claimed driver wait: snapshots bracket
+    // proc reads, and scheduler counters may update at a context switch.
+    mp_info(p->log, "WebHTV FEL wait sample: v=1 op=%s pts=%.6f input=%d output=%d "
+            "wall-us=%lld thread-cpu-us=%lld runqueue-us=%lld sched-running-us=%lld "
+            "slices=%lld voluntary=%lld involuntary=%lld "
+            "sched-error=%d/%d rusage-error=%d/%d acquire=%d/%d probe-us=%lld "
+            "(sampled; -1=unknown; acquire 0=none 1=pending 2=ready negative=error).\n",
+            p->push_descriptors ? "push-descriptors" : "bind-descriptors",
+            p->fel_active_pts, p->fel_active_input, p->fel_active_output,
+            (long long)(MPMAX(0, now - sample->clock.wall) / 1000),
+            (long long)(sample->clock.cpu > 0 && cpu >= sample->clock.cpu
+                ? (cpu - sample->clock.cpu) / 1000 : -1),
+            (long long)(runqueue < 0 ? -1 : runqueue / 1000),
+            (long long)(running < 0 ? -1 : running / 1000),
+            (long long)fel_wait_delta(before->slices, after.slices, sched),
+            (long long)fel_wait_delta(before->voluntary, after.voluntary, usage),
+            (long long)fel_wait_delta(before->involuntary, after.involuntary, usage),
+            before->sched_error, after.sched_error, before->usage_error, after.usage_error,
+            before->acquire, after.acquire, (long long)(probe_ns / 1000));
+}
+
+static void fel_api_end(struct aimagereader_vk_stable *p, enum fel_api_op op,
+                        struct fel_api_clock start)
+{
+    if (!start.wall)
+        return;
+    int64_t now = mp_time_ns();
+    int64_t elapsed = MPMAX(0, now - start.wall);
+    int64_t cpu = mp_fel_thread_cpu_ns();
+    mp_fel_perf_add(&p->fel_api_wall[op], elapsed);
+    if (op == FEL_API_DESCRIPTORS || op == FEL_API_PUSH_DESCRIPTORS)
+        fel_latency_add(&p->fel_bind_window, elapsed);
+    else if (op == FEL_API_RECORD)
+        fel_latency_add(&p->fel_record_window, elapsed);
+    if (start.cpu > 0 && cpu >= start.cpu)
+        mp_fel_perf_add(&p->fel_api_cpu[op], cpu - start.cpu);
+    // Aggregate RECORD contains the individual calls: do not log it twice.
+    // At most four slow calls per three seconds, independently of UI logging.
+    if (op != FEL_API_RECORD && elapsed >= MP_TIME_MS_TO_NS(100)) {
+        if (now < p->fel_slow_window ||
+            now - p->fel_slow_window >= MP_TIME_MS_TO_NS(3000)) {
+            p->fel_slow_window = now;
+            p->fel_slow_count = 0;
+        }
+        if (p->fel_slow_count < 4) {
+            p->fel_slow_count++;
+            mp_info(p->log, "WebHTV FEL api slow: op=%s pts=%.6f input=%d "
+                    "output=%d submitted=%" PRIu64 " wall-us=%lld thread-cpu-us=%lld.\n",
+                    fel_api_names[op], p->fel_active_pts, p->fel_active_input,
+                    p->fel_active_output, p->submitted_outputs,
+                    (long long)(elapsed / 1000),
+                    (long long)(start.cpu > 0 && cpu >= start.cpu
+                        ? (cpu - start.cpu) / 1000 : -1));
+        }
+    }
+}
+
+static void trace_fel_frame_order(struct aimagereader_vk_stable *p, char action,
+                                  int output, int input, uint64_t serial,
+                                  double requested_pts, double mapped_pts)
+{
+    if (!p->android_fel || !p->fel_profile)
+        return;
+    struct fel_order_event *event = &p->fel_order[p->fel_order_count % FEL_ORDER_CAPACITY];
+    *event = (struct fel_order_event){serial, requested_pts, mapped_pts, output, input, action};
+    p->fel_order_count++;
+    // This is a diagnostic difference, not proof of bad pixels: filters/seeks
+    // can alter display timestamps. Never drop or fail a frame on this counter.
+    if (action == 'R' && requested_pts != mapped_pts) {
+        p->fel_pts_differences++;
+        p->fel_last_pts_difference = *event;
+    }
+}
+
+static void format_fel_frame_order(struct aimagereader_vk_stable *p,
+                                   char *line, size_t size)
+{
+    if (!size)
+        return;
+    line[0] = '\0';
+    size_t used = 0;
+    if (p->fel_pts_differences) {
+        const struct fel_order_event *e = &p->fel_last_pts_difference;
+        int written = snprintf(line, size, " last-diff=#%" PRIu64 "/o%d/i%d:%.6f>%.6f",
+            e->serial, e->output, e->input, e->requested_pts, e->mapped_pts);
+        if (written < 0 || (size_t)written >= size)
+            return;
+        used = written;
+    }
+    int count = MPMIN(p->fel_order_count, FEL_ORDER_CAPACITY);
+    for (int n = 0; n < count; n++) {
+        const struct fel_order_event *e =
+            &p->fel_order[(p->fel_order_count - count + n) % FEL_ORDER_CAPACITY];
+        int written = snprintf(line + used, size - used,
+            " %c#%" PRIu64 "/o%d/i%d:%.6f>%.6f", e->action, e->serial,
+            e->output, e->input, e->requested_pts, e->mapped_pts);
+        if (written < 0 || (size_t)written >= size - used)
+            break;
+        used += written;
+    }
+}
+
+static void fel_perf_checkpoint(struct aimagereader_vk_stable *p,
+                                enum mp_fel_perf_stage stage)
+{
+    if (!p->fel_map_checkpoint)
+        return;
+    int64_t now = mp_time_ns();
+    if (p->fel_profile_warm)
+        mp_fel_perf_add(&p->fel_map_stages[stage],
+                       MPMAX(0, now - p->fel_map_checkpoint));
+    p->fel_map_checkpoint = now;
+}
+
+static void fel_perf_finish_map(struct aimagereader_vk_stable *p)
+{
+    if (!p->fel_map_started)
+        return;
+    fel_perf_checkpoint(p, MP_FEL_PERF_OTHER);
+    mp_fel_perf_add(p->fel_profile_warm ? &p->fel_map_warm : &p->fel_map_cold,
+                   MPMAX(0, p->fel_map_checkpoint - p->fel_map_started));
+    if (p->fel_profile_warm)
+        fel_latency_add(&p->fel_map_window,
+                        MPMAX(0, p->fel_map_checkpoint - p->fel_map_started));
+    int64_t cpu = mp_fel_thread_cpu_ns();
+    if (p->fel_profile_warm && p->fel_map_cpu_started > 0 && cpu >= p->fel_map_cpu_started)
+        mp_fel_perf_add(&p->fel_map_cpu, cpu - p->fel_map_cpu_started);
+    p->fel_map_started = p->fel_map_checkpoint = 0;
+}
+
+// Called only AFTER the existing copy fence has signalled. Without that fence
+// a recycled query could still expose the previous frame's available result.
+static void collect_fel_gpu_time(struct aimagereader_vk_stable *p,
+                                  struct vk_output *output)
+{
+    if (!output->fel_query_recorded)
+        return;
+    output->fel_query_recorded = false;
+    uint64_t values[2] = {0};
+    VkResult result = vkGetQueryPoolResults(p->device, p->fel_query_pool,
+        2 * (uint32_t)(output - p->outputs), 2, sizeof(values), values,
+        sizeof(values[0]), VK_QUERY_RESULT_64_BIT); // deliberately no WAIT_BIT
+    uint64_t ns;
+    if (result == VK_SUCCESS && mp_fel_gpu_duration(values[0], values[1],
+            p->fel_timestamp_bits, p->fel_timestamp_period, &ns)) {
+        mp_fel_perf_add(&p->fel_gpu_copy, ns);
+    } else {
+        p->fel_query_unavailable++;
+        if (result != VK_NOT_READY)
+            p->fel_query_failed = true; // diagnostics must never fail playback
+    }
+}
+
+static void init_fel_gpu_timer(struct aimagereader_vk_stable *p)
+{
+    if (!p->fel_profile)
+        return;
+    uint32_t count = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(p->vk->phys_device, &count, NULL);
+    if (p->queue_family >= count)
+        return;
+    VkQueueFamilyProperties *families = talloc_array(NULL, VkQueueFamilyProperties, count);
+    if (!families)
+        return;
+    vkGetPhysicalDeviceQueueFamilyProperties(p->vk->phys_device, &count, families);
+    p->fel_timestamp_bits = p->queue_family < count
+        ? families[p->queue_family].timestampValidBits : 0;
+    talloc_free(families);
+    VkPhysicalDeviceProperties props;
+    vkGetPhysicalDeviceProperties(p->vk->phys_device, &props);
+    p->fel_timestamp_period = props.limits.timestampPeriod;
+    if (!p->fel_timestamp_bits || !isfinite(p->fel_timestamp_period) ||
+        p->fel_timestamp_period <= 0)
+        return;
+    VkQueryPoolCreateInfo info = {
+        .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+        .queryType = VK_QUERY_TYPE_TIMESTAMP,
+        .queryCount = 2 * p->output_capacity,
+    };
+    if (vkCreateQueryPool(p->device, &info, NULL, &p->fel_query_pool) != VK_SUCCESS)
+        p->fel_query_pool = VK_NULL_HANDLE;
+    mp_info(p->log, "WebHTV FEL perf: timer=%s bits=%u period-ns=%.3f "
+                    "queue-family=%u compute-queues=%d graphics-family=%u "
+                    "graphics-queues=%d no-query-wait=1.\n",
+            p->fel_query_pool ? "gpu-timestamp" : "unavailable",
+            p->fel_timestamp_bits, p->fel_timestamp_period, p->queue_family,
+            p->vk->queue_compute.count, p->vk->queue_graphics.index,
+            p->vk->queue_graphics.count);
+}
+
+static void log_fel_pool(struct aimagereader_vk_stable *p, bool force)
+{
+    if (!p->android_fel)
+        return;
+    double now = mp_time_sec();
+    if (!force && p->submitted_outputs > 2 && now - p->fel_log_at < 3.0)
+        return;
+    int held = 0, pending = 0;
+    for (int n = 0; n < p->output_count; n++) {
+        held += p->outputs[n].source_image != NULL;
+        pending += p->outputs[n].pending;
+    }
+    mp_info(p->log, "WebHTV FEL GPU pool: submitted=%" PRIu64
+                    " completed=%" PRIu64 " source-held=%d pending=%d "
+                    "output-depth=%d fence-timeouts=%" PRIu64
+                    " copy-wait-us=%" PRIu64 " max-copy-wait-us=%" PRIu64
+                    " cache-slots=%d final=%d async-returns=%" PRIu64
+                    " release-failures=%" PRIu64 "\n", p->submitted_outputs, p->completed_outputs,
+            held, pending, p->resources_ready ? output_sample_depth(p->output_format) : 0,
+            p->fence_timeouts, p->fel_wait_ns / 1000, p->fel_max_wait_ns / 1000,
+            p->output_count, force, p->fel_async_returns, p->fel_release_failures);
+    p->fel_log_at = now;
+    if (p->fel_profile) {
+        mp_info(p->log, "WebHTV FEL perf: warm-attempts=%" PRIu64
+                " warm-map-us=%" PRIu64 " cpu-samples=%" PRIu64
+                " thread-cpu-us=%" PRIu64 " cold-attempts=%" PRIu64
+                " cold-map-us=%" PRIu64 " gpu-samples=%" PRIu64
+                " gpu-copy-us=%" PRIu64 " gpu-copy-max-us=%" PRIu64
+                " gpu-unavailable=%" PRIu64 " gpu-disabled=%d final=%d.\n",
+                p->fel_map_warm.count, p->fel_map_warm.total / 1000,
+                p->fel_map_cpu.count, p->fel_map_cpu.total / 1000,
+                p->fel_map_cold.count, p->fel_map_cold.total / 1000,
+                p->fel_gpu_copy.count, p->fel_gpu_copy.total / 1000,
+                p->fel_gpu_copy.peak / 1000, p->fel_query_unavailable,
+                !p->fel_query_pool || p->fel_query_failed, force);
+        mp_info(p->log, "WebHTV FEL perf stages: poll-us=%" PRIu64
+                " import-us=%" PRIu64 " reclaim-us=%" PRIu64
+                " record-us=%" PRIu64 " acquire-us=%" PRIu64
+                " queue-lock-us=%" PRIu64 " submit-us=%" PRIu64
+                " tex-release-us=%" PRIu64 " export-us=%" PRIu64
+                " image-return-us=%" PRIu64 " other-us=%" PRIu64
+                " (warm cumulative CPU wall time).\n",
+                p->fel_map_stages[MP_FEL_PERF_POLL].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_IMPORT].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_RECLAIM].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_RECORD].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_ACQUIRE].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_QUEUE_LOCK].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_SUBMIT].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_TEX_RELEASE].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_EXPORT].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_IMAGE_RETURN].total / 1000,
+                p->fel_map_stages[MP_FEL_PERF_OTHER].total / 1000);
+        const struct fel_latency_window *windows[] = {
+            &p->fel_bind_window, &p->fel_record_window, &p->fel_map_window,
+        };
+        const char *const names[] = {"bind", "record", "map"};
+        char latency[512];
+        int latency_used = 0;
+        for (int n = 0; n < MP_ARRAY_SIZE(windows); n++) {
+            uint64_t summary[3];
+            fel_latency_summary(windows[n], summary);
+            latency_used += snprintf(latency + latency_used,
+                sizeof(latency) - latency_used, " %s=%u/%" PRIu64 "/%" PRIu64 "/%" PRIu64,
+                names[n], windows[n]->count, summary[0], summary[1], summary[2]);
+        }
+        mp_info(p->log, "WebHTV FEL reuse: input-hit=%" PRIu64
+                " input-miss=%" PRIu64 " input-evict=%" PRIu64
+                " input-removed=%" PRIu64 " input-slots=%d input-limit=%d"
+                " command-hit=%" PRIu64 " command-miss=%" PRIu64
+                " command-evict=%" PRIu64 " invalidated=%" PRIu64
+                " fallback=%" PRIu64 " cold=%" PRIu64
+                " records=%d record-limit=%d disabled=%d fresh-commands=%" PRIu64
+                " descriptor-content-cache=1 content-hit=%" PRIu64
+                " descriptor-writes=%" PRIu64 " descriptor-rebinds=%" PRIu64
+                " command-mode=fresh-bind-record replay=0. latency-window:%s "
+                "(warm last<=128 n/p50-us/p95-us/max-us; overlapping stages).\n",
+                p->input_hits, p->input_misses, p->input_evictions,
+                p->input_removals, p->num_inputs, FEL_INPUT_CACHE_SIZE,
+                p->recording_hits, p->recording_misses, p->recording_evictions,
+                p->recording_invalidations, p->recording_fallbacks,
+                p->recording_cold, p->num_recordings, FEL_RECORD_CACHE_SIZE,
+                p->recording_cache_disabled, p->fresh_commands,
+                p->descriptor_content_hits, p->descriptor_writes, p->descriptor_rebinds,
+                latency);
+        char order[1024];
+        format_fel_frame_order(p, order, sizeof(order));
+        mp_info(p->log, "WebHTV FEL frame order: events=%" PRIu64
+                " pts-different=%" PRIu64 " (M=map R=reselect A=alias X=miss; "
+                "serial/output/input:requested>stored; logical identity, not pixel checksum):%s\n",
+                p->fel_order_count, p->fel_pts_differences, order);
+        // Three bounded aggregate lines per three seconds, not per-frame logging.
+        for (int first = 0; first < FEL_API_COUNT; first += 6) {
