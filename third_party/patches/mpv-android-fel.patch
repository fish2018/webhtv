+    ctx->fel_call_max_ns = MPMAX(ctx->fel_call_max_ns, elapsed);
+    if (send) {
+        ctx->fel_send_calls++;
+        ctx->fel_send_ns += elapsed;
+    } else {
+        ctx->fel_receive_calls++;
+        ctx->fel_receive_ns += elapsed;
+        ctx->fel_decoded += result >= 0;
