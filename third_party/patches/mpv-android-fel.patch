diff --git a/filters/f_android_fel.h b/filters/f_android_fel.h
new file mode 100644
--- /dev/null
+++ b/filters/f_android_fel.h
@@ -0,0 +1,121 @@
+/* WebHTV Android FEL queue policy. LGPL-2.1-or-later, like mpv. */
+#pragma once
+
+#include <stdbool.h>
+#include <string.h>
+
+// Publish under the wrapper's cache lock. The getter copies this value into
+// caller-owned storage: never return a pointer into a live decoder's name.
+struct mp_android_fel_hwdec_snapshot {
+    bool available;
+    unsigned long long revision;
+    char name[64]; // vd_lavc's method_name is currently at most 24 bytes.
+};
+
+static inline void mp_android_fel_publish_hwdec(
+    struct mp_android_fel_hwdec_snapshot *snapshot, bool available,
+    const char *name)
+{
+    if (!name)
+        name = "";
+    if (!available || strlen(name) >= sizeof(snapshot->name)) {
+        available = false;
+        name = "";
+    }
+    if (snapshot->available == available && !strcmp(snapshot->name, name))
+        return;
+    snapshot->available = available;
+    memcpy(snapshot->name, name, strlen(name) + 1);
+    snapshot->revision++;
+}
+
+// These are retained decoded frames, not an assumed MediaCodec pool capacity.
+#define MP_ANDROID_FEL_BL_PENDING 1
+#define MP_ANDROID_FEL_EL_PENDING 8
+#define MP_ANDROID_FEL_BL_PREFETCH 1
+#define MP_ANDROID_FEL_EL_PREFETCH 4
+#define MP_ANDROID_FEL_ERROR_LIMIT 8
+#define MP_ANDROID_FEL_COPY_WAIT_NS 100000000LL
+#define MP_ANDROID_FEL_FRAME_TIMEOUT_NS 750000000LL
+#define MP_ANDROID_FEL_INIT_TIMEOUT_NS 10000000000LL
+
+// A source is safe to publish after CPU-observed GPU completion, or after an
+// exported GPU release fence has been handed to AImage_deleteAsync. The latter
+// allows overlap; it never permits the codec to overwrite unfinished GPU input.
+// Keep actual GPU completion separate from fence-backed source handoff.
+static inline bool mp_android_fel_staging_ready(const unsigned char *state)
+{
+    return state && (__atomic_load_n(state, __ATOMIC_ACQUIRE) & 1);
+}
+
+static inline bool mp_android_fel_staging_gpu_complete(const unsigned char *state)
+{
+    return state && (__atomic_load_n(state, __ATOMIC_ACQUIRE) & 2);
+}
+
+static inline void mp_android_fel_staging_release_fenced(unsigned char *state)
+{
+    if (state)
+        __atomic_fetch_or(state, 1, __ATOMIC_RELEASE);
+}
+
+static inline void mp_android_fel_staging_complete(unsigned char *state)
+{
+    if (state)
+        __atomic_fetch_or(state, 3, __ATOMIC_RELEASE);
+}
+
+// Monotonic, per-lease cold-initialization phases, independent of source/GPU
+// completion. The mapper, not the caller's frame count, identifies cold work.
+static inline unsigned char mp_android_fel_staging_init_phase(const unsigned char *state)
+{
+    return state ? __atomic_load_n(state, __ATOMIC_ACQUIRE) & 60 : 0;
+}
+
+// A user-requested diagnostic may hold this one source beyond the ordinary
+// frame deadline. Its own deadline is fixed; polling cannot renew it.
+static inline void mp_android_fel_staging_begin_probe(unsigned char *state)
+{
+    if (state)
+        __atomic_fetch_or(state, 16, __ATOMIC_RELEASE);
+}
+
+static inline void mp_android_fel_staging_end_probe(unsigned char *state)
+{
+    if (state)
+        __atomic_fetch_or(state, 32, __ATOMIC_RELEASE);
+}
+
+static inline void mp_android_fel_staging_begin_init(unsigned char *state)
+{
+    if (state)
+        __atomic_fetch_or(state, 4, __ATOMIC_RELEASE);
+}
+
+static inline void mp_android_fel_staging_end_init(unsigned char *state)
+{
+    if (state)
+        __atomic_fetch_or(state, 8, __ATOMIC_RELEASE);
+}
+
+static inline bool mp_android_fel_stage_output(bool fel, bool direct_or_auto)
+{
+    return fel && direct_or_auto;
+}
+
+static inline bool mp_android_fel_preserve_depth(bool fel, int depth)
+{
+    return !fel || depth >= 10;
+}
+
+static inline bool mp_android_fel_can_skip_bl(bool el_eof, bool have_el,
+                                              int pts_order)
+{
+    // A full BL queue is backpressure, never evidence that EL is absent.
+    return el_eof || (have_el && pts_order > 0);
+}
+
+static inline bool mp_android_fel_decode_failed(bool fel, int consecutive_errors)
+{
+    return fel && consecutive_errors >= MP_ANDROID_FEL_ERROR_LIMIT;
+}
diff --git a/filters/f_android_fel_perf.h b/filters/f_android_fel_perf.h
new file mode 100644
--- /dev/null
+++ b/filters/f_android_fel_perf.h
@@ -0,0 +1,52 @@
+/* Optional Android FEL measurements. LGPL-2.1-or-later, like mpv. */
+#pragma once
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <time.h>
+
+enum mp_fel_perf_stage {
+    MP_FEL_PERF_POLL, MP_FEL_PERF_IMPORT, MP_FEL_PERF_RECLAIM,
+    MP_FEL_PERF_RECORD, MP_FEL_PERF_ACQUIRE, MP_FEL_PERF_QUEUE_LOCK,
+    MP_FEL_PERF_SUBMIT, MP_FEL_PERF_TEX_RELEASE, MP_FEL_PERF_EXPORT,
+    MP_FEL_PERF_IMAGE_RETURN, MP_FEL_PERF_OTHER, MP_FEL_PERF_COUNT,
+};
+
+struct mp_fel_perf_stat {
+    uint64_t count, total, peak;
+};
+
+static inline void mp_fel_perf_add(struct mp_fel_perf_stat *stat, uint64_t ns)
+{
+    stat->count++;
+    stat->total += ns;
+    if (ns > stat->peak)
+        stat->peak = ns;
+}
+
+static inline int64_t mp_fel_thread_cpu_ns(void)
+{
+#ifdef CLOCK_THREAD_CPUTIME_ID
+    struct timespec ts;
+    if (!clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts))
+        return (int64_t)ts.tv_sec * INT64_C(1000000000) + ts.tv_nsec;
+#endif
+    return 0; // unavailable, never fabricate a CPU utilization value
+}
+
+static inline bool mp_fel_gpu_duration(uint64_t start, uint64_t end,
+                                        unsigned bits, double period,
+                                        uint64_t *ns)
+{
+    if (!bits || bits > 64 || !isfinite(period) || period <= 0)
+        return false;
+    uint64_t delta = end - start;
+    if (bits < 64)
+        delta &= (UINT64_C(1) << bits) - 1;
+    double duration = delta * period;
+    if (!isfinite(duration) || duration >= (double)UINT64_MAX)
+        return false;
+    *ns = (uint64_t)duration;
+    return true;
+}
diff --git a/filters/f_android_fel_trace.h b/filters/f_android_fel_trace.h
new file mode 100644
--- /dev/null
+++ b/filters/f_android_fel_trace.h
@@ -0,0 +1,145 @@
+/* WebHTV FEL progress diagnostics. LGPL-2.1-or-later, like mpv. */
+#pragma once
+
+#include <inttypes.h>
+#include <math.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdio.h>
+
+// A diagnostic read must never wait for a decoder, the core, or the GPU.
+_Static_assert(ATOMIC_LLONG_LOCK_FREE == 2 && ATOMIC_LONG_LOCK_FREE == 2 &&
+               ATOMIC_INT_LOCK_FREE == 2 && ATOMIC_BOOL_LOCK_FREE == 2,
+               "FEL progress stamps require lock-free 64-bit atomics");
+
+enum mp_fel_lane { MP_FEL_CORE, MP_FEL_BL, MP_FEL_EL, MP_FEL_VO, MP_FEL_LANES };
+enum mp_fel_stage {
+    MP_FEL_UNKNOWN, MP_FEL_CORE_BEGIN, MP_FEL_CORE_PULL, MP_FEL_CORE_WAIT,
+    MP_FEL_CORE_SYNC, MP_FEL_CORE_SUBTITLE, MP_FEL_CORE_READY, MP_FEL_CORE_QUEUE,
+    MP_FEL_CORE_IDLE, MP_FEL_SEND, MP_FEL_RECEIVE, MP_FEL_NEED_PACKET,
+    MP_FEL_DECODED, MP_FEL_DECODE_IDLE, MP_FEL_EOF, MP_FEL_RESET,
+    MP_FEL_VO_DRAW, MP_FEL_VO_PRELOAD, MP_FEL_VO_TARGET, MP_FEL_VO_ACQUIRE,
+    MP_FEL_VO_QUEUE, MP_FEL_VO_RENDER, MP_FEL_VO_FLUSH, MP_FEL_VO_SUBMIT,
+    MP_FEL_VO_SWAP, MP_FEL_VO_IDLE,
+    MP_FEL_VO_DROP_PRELOAD, MP_FEL_VO_DROP_DONE,
+    MP_FEL_CORE_PRELOAD, MP_FEL_VO_CORE_PRELOAD,
+};
+
+struct mp_fel_lane_trace {
+    // Stage and its start time are one atomic value, even on ARMv7.
+    atomic_uint_fast64_t stamp;
+    atomic_int pts_ms;
+    atomic_uint inputs, outputs, held;
+};
+
+struct mp_fel_trace {
+    atomic_bool enabled;
+    atomic_uint requested, references;
+    atomic_uint vo_drops, vo_drop_prepared, vo_drop_retries;
+    atomic_uint core_prepare_requests, core_prepare_completed;
+    atomic_uint core_prepare_retries, core_prepare_errors;
+    struct mp_fel_lane_trace lanes[MP_FEL_LANES];
+};
+
+static inline void mp_fel_trace_init(struct mp_fel_trace *trace)
+{
+    atomic_init(&trace->enabled, false);
+    atomic_init(&trace->requested, 1);
+    atomic_init(&trace->references, 2);
+    atomic_init(&trace->vo_drops, 0);
+    atomic_init(&trace->vo_drop_prepared, 0);
+    atomic_init(&trace->vo_drop_retries, 0);
+    atomic_init(&trace->core_prepare_requests, 0);
+    atomic_init(&trace->core_prepare_completed, 0);
+    atomic_init(&trace->core_prepare_retries, 0);
+    atomic_init(&trace->core_prepare_errors, 0);
+    for (int n = 0; n < MP_FEL_LANES; n++) {
+        struct mp_fel_lane_trace *lane = &trace->lanes[n];
+        atomic_init(&lane->stamp, 0);
+        atomic_init(&lane->pts_ms, -1);
+        atomic_init(&lane->inputs, 0);
+        atomic_init(&lane->outputs, 0);
+        atomic_init(&lane->held, 0);
+    }
+}
+
+static inline void mp_fel_trace_record(struct mp_fel_trace *trace,
+                                      enum mp_fel_lane index,
+                                      enum mp_fel_stage stage, int64_t now_ms,
+                                      double pts, int held,
+                                      unsigned inputs, unsigned outputs)
+{
+    if (!trace || !atomic_load_explicit(&trace->enabled, memory_order_relaxed))
+        return;
+    struct mp_fel_lane_trace *lane = &trace->lanes[index];
+    if (isfinite(pts) && pts >= 0 && pts <= INT32_MAX / 1000.0)
+        atomic_store_explicit(&lane->pts_ms, (int)(pts * 1000.0), memory_order_relaxed);
+    if (held >= 0)
+        atomic_store_explicit(&lane->held, held, memory_order_relaxed);
+    if (inputs)
+        atomic_fetch_add_explicit(&lane->inputs, inputs, memory_order_relaxed);
+    if (outputs)
+        atomic_fetch_add_explicit(&lane->outputs, outputs, memory_order_relaxed);
+    uint64_t stamp = ((uint64_t)(uint32_t)now_ms << 8) | (unsigned)stage;
+    atomic_store_explicit(&lane->stamp, stamp, memory_order_relaxed);
+}
+
+static inline const char *mp_fel_stage_name(unsigned stage)
+{
+    static const char *const names[] = {
+        "unknown", "core-begin", "core-pull", "core-wait-frame",
+        "core-sync-or-pause", "core-subtitle", "core-wait-vo", "core-queue",
+        "core-idle", "codec-send", "codec-receive", "codec-need-packet",
+        "codec-decoded", "codec-idle", "codec-eof", "codec-reset",
+        "vo-draw", "vo-preload", "vo-target-hint", "vo-acquire-swapchain",
+        "vo-queue-update", "vo-render", "vo-flush", "vo-submit",
+        "vo-swap-buffers", "vo-idle",
+        "vo-drop-preload", "vo-drop-done",
+        "core-preload-wait", "vo-core-preload",
+    };
+    return stage < sizeof(names) / sizeof(names[0]) ? names[stage] : "unknown";
+}
+
+// Counters are best-effort independently atomic observations, not a global
+// transaction. Only a lane's stage/time pair is guaranteed to be coherent.
+static inline void mp_fel_trace_format(struct mp_fel_trace *trace,
+                                      int64_t now_ms, char *text, size_t size)
+{
+    if (!size)
+        return;
+    if (!trace) {
+        snprintf(text, size, "VO unavailable");
+        return;
+    }
+    int len = snprintf(text, size, "v=1 requested=%u refs=%u "
+        "surface-drops=%u drop-prepared=%u drop-retries=%u "
+        "core-preload={requests=%u done=%u retries=%u errors=%u}",
+        atomic_load_explicit(&trace->requested, memory_order_relaxed),
+        atomic_load_explicit(&trace->references, memory_order_relaxed),
+        atomic_load_explicit(&trace->vo_drops, memory_order_relaxed),
+        atomic_load_explicit(&trace->vo_drop_prepared, memory_order_relaxed),
+        atomic_load_explicit(&trace->vo_drop_retries, memory_order_relaxed),
+        atomic_load_explicit(&trace->core_prepare_requests, memory_order_relaxed),
+        atomic_load_explicit(&trace->core_prepare_completed, memory_order_relaxed),
+        atomic_load_explicit(&trace->core_prepare_retries, memory_order_relaxed),
+        atomic_load_explicit(&trace->core_prepare_errors, memory_order_relaxed));
+    if (len < 0)
+        return;
+    size_t used = (size_t)len < size ? (size_t)len : size - 1;
+    static const char *const names[] = {"core", "BL", "EL", "VO"};
+    for (int n = 0; n < MP_FEL_LANES && used < size - 1; n++) {
+        struct mp_fel_lane_trace *lane = &trace->lanes[n];
+        uint64_t stamp = atomic_load_explicit(&lane->stamp, memory_order_relaxed);
+        uint32_t age = (uint32_t)now_ms - (uint32_t)(stamp >> 8);
+        len = snprintf(text + used, size - used,
+            " %s={%s age=%" PRIu32 "ms pts=%d in=%u out=%u held=%u}",
+            names[n], mp_fel_stage_name(stamp & 255), stamp ? age : 0,
+            atomic_load_explicit(&lane->pts_ms, memory_order_relaxed),
+            atomic_load_explicit(&lane->inputs, memory_order_relaxed),
+            atomic_load_explicit(&lane->outputs, memory_order_relaxed),
+            atomic_load_explicit(&lane->held, memory_order_relaxed));
+        if (len < 0)
+            break;
+        used += (size_t)len < size - used ? (size_t)len : size - used - 1;
+    }
+}
