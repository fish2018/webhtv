+static void log_fel_descriptor_capabilities(struct aimagereader_vk_stable *p)
+{
+    if (!p->android_fel || !mp_msg_test(p->log, MSGL_INFO))
+        return;
+    PFN_vkEnumerateDeviceExtensionProperties enumerate =
+        (PFN_vkEnumerateDeviceExtensionProperties)p->vk->get_proc_addr(
+            p->vk->instance, "vkEnumerateDeviceExtensionProperties");
+    PFN_vkGetPhysicalDeviceProperties get_properties =
+        (PFN_vkGetPhysicalDeviceProperties)p->vk->get_proc_addr(
+            p->vk->instance, "vkGetPhysicalDeviceProperties");
+    VkPhysicalDeviceProperties props = {0};
+    if (get_properties)
+        get_properties(p->vk->phys_device, &props);
+    props.deviceName[sizeof(props.deviceName) - 1] = '\0';
+    for (char *c = props.deviceName; *c; c++) {
+        if ((unsigned char)*c < 32 || (unsigned char)*c >= 127)
+            *c = '?';
+    }
+    int supported = -1;
+    uint32_t count = 0;
+    VkResult result = enumerate ? enumerate(p->vk->phys_device, NULL, &count, NULL)
+                                : VK_ERROR_EXTENSION_NOT_PRESENT;
+    if (result == VK_SUCCESS && count <= 512) {
+        uint32_t capacity = count;
+        VkExtensionProperties *extensions = count ? calloc(count, sizeof(*extensions)) : NULL;
+        if (count && !extensions) {
+            result = VK_ERROR_OUT_OF_HOST_MEMORY;
+        } else {
+            result = count ? enumerate(p->vk->phys_device, NULL, &count, extensions) : VK_SUCCESS;
+            if (count > capacity) {
+                count = capacity;
+                result = VK_INCOMPLETE;
+            }
+            supported = result == VK_SUCCESS ? 0 : -1;
+            if (result == VK_SUCCESS || result == VK_INCOMPLETE) {
+                for (uint32_t n = 0; n < count; n++) {
+                    if (strncmp(extensions[n].extensionName,
+                                VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME,
+                                VK_MAX_EXTENSION_NAME_SIZE) == 0)
+                        supported = 1;
+                }
+            }
+        }
+        free(extensions);
+    } else if (result == VK_SUCCESS) {
+        result = VK_INCOMPLETE; // Bound diagnostic allocation; support is unknown.
+    }
+    mp_info(p->log, "WebHTV FEL descriptors: capability-v=1 "
+            "api=%u.%u.%u device-api=%u.%u.%u vendor=0x%x device=0x%x driver=0x%x "
+            "gpu=\"%s\" properties=%d push-supported=%d push-enabled=%d "
+            "extension-query-result=%d (advertised extension; -1=unknown).\n",
+            VK_VERSION_MAJOR(p->vk->api_version), VK_VERSION_MINOR(p->vk->api_version),
+            VK_VERSION_PATCH(p->vk->api_version), VK_VERSION_MAJOR(props.apiVersion),
+            VK_VERSION_MINOR(props.apiVersion), VK_VERSION_PATCH(props.apiVersion),
+            props.vendorID, props.deviceID, props.driverVersion, props.deviceName,
+            get_properties != NULL, supported,
+            has_extension(p->vk, VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME), result);
+}
