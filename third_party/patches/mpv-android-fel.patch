+static bool output_has_live_fel_frame(struct aimagereader_vk_stable *p,
+                                       struct vk_output *output)
+{
+    if (!p->android_fel)
+        return false;
+    for (int n = -1; n < output->num_source_aliases; n++) {
+        struct mp_image *frame = n < 0 ? output->source_frame : output->source_aliases[n];
+        AVBufferRef *lease = frame ? frame->android_fel_staging : NULL;
+        if (!lease)
+            continue;
+        // Cache references are not consumers. Count aliases of the same lease
+        // as well, so retaining an identity twice cannot pin a slot forever.
+        int owned = 0;
+        for (int k = -1; k < output->num_source_aliases; k++) {
+            struct mp_image *other = k < 0 ? output->source_frame : output->source_aliases[k];
+            owned += other && other->android_fel_staging &&
+                     other->android_fel_staging->data == lease->data;
+        }
+        if (av_buffer_get_ref_count(lease) > owned)
+            return true;
+    }
+    return false;
+}
