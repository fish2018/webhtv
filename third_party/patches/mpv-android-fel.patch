diff --git a/video/out/fel_bind_probe.h b/video/out/fel_bind_probe.h
new file mode 100644
--- /dev/null
+++ b/video/out/fel_bind_probe.h
@@ -0,0 +1,92 @@
+/* Explicit, per-VO diagnostic requests. LGPL-2.1-or-later, like mpv. */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define MP_FEL_PROBE_TIMEOUT_NS INT64_C(30000000000)
+#define MP_FEL_PROBE_GROUP_NS INT64_C(5000000000)
+#define MP_FEL_PROBE_MEMORY_LIMIT (UINT64_C(96) * 1024 * 1024)
+#define MP_FEL_PROBE_WARMUP 8
+#define MP_FEL_PROBE_SAMPLES 32
+
+enum mp_fel_probe_state {
+    MP_FEL_PROBE_IDLE, MP_FEL_PROBE_ARMED, MP_FEL_PROBE_QUIESCING,
+    MP_FEL_PROBE_RUNNING, MP_FEL_PROBE_DONE, MP_FEL_PROBE_CANCELLED,
+    MP_FEL_PROBE_FAILED, MP_FEL_PROBE_TIMED_OUT,
+};
+
+struct mp_fel_bind_probe {
+    // Zero-initialized with the VO. Core publishes a request; only its mapper
+    // finishes a claimed request, after releasing all diagnostic references.
+    int state;
+    bool cancel, supported, reported_supported;
+    int reported; // core only
+    uint64_t serial;
+    int64_t deadline;
+};
+
+static inline int mp_fel_probe_state(const struct mp_fel_bind_probe *p)
+{
+    return __atomic_load_n(&p->state, __ATOMIC_ACQUIRE);
+}
+
+static inline bool mp_fel_probe_active(const struct mp_fel_bind_probe *p)
+{
+    int state = mp_fel_probe_state(p);
+    return state >= MP_FEL_PROBE_ARMED && state <= MP_FEL_PROBE_RUNNING;
+}
+
+static inline bool mp_fel_probe_holds_playback(const struct mp_fel_bind_probe *p)
+{
+    int state = mp_fel_probe_state(p);
+    return state == MP_FEL_PROBE_QUIESCING || state == MP_FEL_PROBE_RUNNING;
+}
+
+static inline bool mp_fel_probe_start(struct mp_fel_bind_probe *p, int64_t now)
+{
+    if (mp_fel_probe_active(p))
+        return false;
+    p->serial++;
+    p->deadline = now + MP_FEL_PROBE_TIMEOUT_NS;
+    __atomic_store_n(&p->cancel, false, __ATOMIC_RELEASE);
+    __atomic_store_n(&p->state, MP_FEL_PROBE_ARMED, __ATOMIC_RELEASE);
+    return true;
+}
+
+static inline bool mp_fel_probe_claim(struct mp_fel_bind_probe *p)
+{
+    int expected = MP_FEL_PROBE_ARMED;
+    return __atomic_compare_exchange_n(&p->state, &expected,
+        MP_FEL_PROBE_QUIESCING, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+
+static inline void mp_fel_probe_cancel(struct mp_fel_bind_probe *p)
+{
+    __atomic_store_n(&p->cancel, true, __ATOMIC_RELEASE);
+    int expected = MP_FEL_PROBE_ARMED;
+    // An unclaimed request owns no image. A claimed request remains paused
+    // until the mapper has unwound; a new start must not race its cleanup.
+    __atomic_compare_exchange_n(&p->state, &expected, MP_FEL_PROBE_CANCELLED,
+        false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+
+static inline bool mp_fel_probe_live(const struct mp_fel_bind_probe *p, int64_t now)
+{
+    return mp_fel_probe_active(p) &&
+        !__atomic_load_n(&p->cancel, __ATOMIC_ACQUIRE) && now < p->deadline;
+}
+
+static inline const char *mp_fel_probe_name(int state)
+{
+    switch (state) {
+    case MP_FEL_PROBE_IDLE: return "ready";
+    case MP_FEL_PROBE_ARMED: return "armed";
+    case MP_FEL_PROBE_QUIESCING: return "quiescing";
+    case MP_FEL_PROBE_RUNNING: return "running";
+    case MP_FEL_PROBE_DONE: return "completed";
+    case MP_FEL_PROBE_CANCELLED: return "cancelled";
+    case MP_FEL_PROBE_TIMED_OUT: return "timed-out";
+    default: return "failed";
+    }
+}
diff --git a/video/out/hwdec/hwdec_aimagereader_vk_probe.inc b/video/out/hwdec/hwdec_aimagereader_vk_probe.inc
new file mode 100644
--- /dev/null
+++ b/video/out/hwdec/hwdec_aimagereader_vk_probe.inc
@@ -0,0 +1,395 @@
+/* Included by the stable mapper: user-requested, record-only diagnostics.
+ * LGPL-2.1-or-later. No diagnostic command is submitted for GPU execution. */
+
+struct fel_probe_target {
+    VkImage image;
+    VkDeviceMemory memory;
+    VkImageView view;
+    VkDeviceSize bytes;
+};
+
+struct fel_probe_group {
+    VkCommandPool commands;
+    VkCommandBuffer command;
+    VkDescriptorPool pool;
+    VkDescriptorSetLayout layout;
+    VkPipelineLayout pipeline_layout;
+    VkDescriptorSet set;
+};
+
+static void fel_probe_retire_drains(struct aimagereader_vk_stable *p, bool teardown)
+{
+    unsigned keep = 0;
+    for (unsigned i = 0; i < p->fel_probe_drain_count; i++) {
+        VkFence fence = p->fel_probe_drains[i];
+        // Only teardown may wait like the existing conversion teardown. Normal
+        // cancellation retains unfinished fences and returns to playback.
+        VkResult result = teardown
+            ? vkWaitForFences(p->device, 1, &fence, VK_TRUE, UINT64_MAX)
+            : vkGetFenceStatus(p->device, fence);
+        if (result != VK_SUCCESS && result != VK_NOT_READY && result != VK_TIMEOUT)
+            p->fel_probe_drain_failed = true;
+        if (result == VK_SUCCESS || result == VK_ERROR_DEVICE_LOST)
+            vkDestroyFence(p->device, fence, NULL);
+        else
+            p->fel_probe_drains[keep++] = fence;
+    }
+    p->fel_probe_drain_count = keep;
+}
+
+static bool fel_probe_drain_queues(struct aimagereader_vk_stable *p,
+                                 struct mp_fel_bind_probe *probe, unsigned *submitted)
+{
+    if (p->fel_probe_drain_count)
+        return false;
+    p->fel_probe_drain_failed = false;
+    struct pl_vulkan_queue queues[] = {
+        p->vk->queue_graphics, p->vk->queue_compute, p->vk->queue_transfer,
+    };
+    unsigned count = 0;
+    for (unsigned i = 0; i < MP_ARRAY_SIZE(queues); i++) {
+        for (unsigned j = 0; j < i; j++) {
+            if (queues[i].index == queues[j].index && queues[j].count) {
+                queues[j].count = MPMAX(queues[j].count, queues[i].count);
+                queues[i].count = 0;
+                break;
+            }
+        }
+    }
+    for (unsigned i = 0; i < MP_ARRAY_SIZE(queues); i++)
+        count += queues[i].count;
+    if (!count || count > MP_ARRAY_SIZE(p->fel_probe_drains))
+        return false;
+    pl_gpu_flush(p->gpu);
+    int64_t deadline = MPMIN(probe->deadline, mp_time_ns() + INT64_C(2000000000));
+    for (unsigned i = 0; i < MP_ARRAY_SIZE(queues); i++) {
+        for (unsigned q = 0; q < queues[i].count; q++) {
+            if (!mp_fel_probe_live(probe, mp_time_ns()))
+                return false;
+            VkFence fence = VK_NULL_HANDLE;
+            VkFenceCreateInfo info = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+            if (vkCreateFence(p->device, &info, NULL, &fence) != VK_SUCCESS)
+                return false;
+            VkQueue queue;
+            vkGetDeviceQueue(p->device, queues[i].index, q, &queue);
+            p->vk->lock_queue(p->vk, queues[i].index, q);
+            // A fence-only submission orders after prior application work;
+            // no diagnostic dispatch/draw/copy is sent to the GPU.
+            VkResult result = vkQueueSubmit(queue, 0, NULL, fence);
+            p->vk->unlock_queue(p->vk, queues[i].index, q);
+            if (result != VK_SUCCESS) {
+                vkDestroyFence(p->device, fence, NULL);
+                return false;
+            }
+            p->fel_probe_drains[p->fel_probe_drain_count++] = fence;
+            (*submitted)++;
+        }
+    }
+    while (p->fel_probe_drain_count && mp_fel_probe_live(probe, mp_time_ns()) &&
+           mp_time_ns() < deadline) {
+        fel_probe_retire_drains(p, false);
+        if (p->fel_probe_drain_count)
+            mp_sleep_ns(1000000);
+    }
+    return !p->fel_probe_drain_count && !p->fel_probe_drain_failed;
+}
+
+static void fel_probe_destroy_target(struct aimagereader_vk_stable *p,
+                                     struct fel_probe_target *t)
+{
+    if (t->view) vkDestroyImageView(p->device, t->view, NULL);
+    if (t->image) vkDestroyImage(p->device, t->image, NULL);
+    if (t->memory) vkFreeMemory(p->device, t->memory, NULL);
+    *t = (struct fel_probe_target){0};
+}
+
+static bool fel_probe_create_target(struct aimagereader_vk_stable *p,
+                                    struct mp_fel_bind_probe *probe,
+                                    struct fel_probe_target *t)
+{
+    VkImageCreateInfo info = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .imageType = VK_IMAGE_TYPE_2D, .format = p->output_format,
+        .extent = {p->width, p->height, 1}, .mipLevels = 1, .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    if (!mp_fel_probe_live(probe, mp_time_ns()) ||
+        vkCreateImage(p->device, &info, NULL, &t->image) != VK_SUCCESS)
+        return false;
+    VkMemoryRequirements requirements;
+    vkGetImageMemoryRequirements(p->device, t->image, &requirements);
+    t->bytes = requirements.size;
+    if (!t->bytes || t->bytes > MP_FEL_PROBE_MEMORY_LIMIT)
+        return false;
+    uint32_t memory_type = find_memory_type(p, requirements.memoryTypeBits,
+                                           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (memory_type == UINT32_MAX || !mp_fel_probe_live(probe, mp_time_ns()))
+        return false;
+    VkMemoryAllocateInfo alloc = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .allocationSize = t->bytes, .memoryTypeIndex = memory_type,
+    };
+    if (vkAllocateMemory(p->device, &alloc, NULL, &t->memory) != VK_SUCCESS ||
+        !mp_fel_probe_live(probe, mp_time_ns()) ||
+        vkBindImageMemory(p->device, t->image, t->memory, 0) != VK_SUCCESS)
+        return false;
+    VkImageViewCreateInfo view = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+        .image = t->image, .viewType = VK_IMAGE_VIEW_TYPE_2D,
+        .format = p->output_format,
+        .subresourceRange = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                             .levelCount = 1, .layerCount = 1},
+    };
+    return mp_fel_probe_live(probe, mp_time_ns()) &&
+        vkCreateImageView(p->device, &view, NULL, &t->view) == VK_SUCCESS;
+}
+
+static void fel_probe_destroy_group(struct aimagereader_vk_stable *p,
+                                    struct fel_probe_group *g)
+{
+    // Commands are never pending. Drop all command references before sets,
+    // pipeline layouts, immutable samplers or their image views are released.
+    if (g->commands) vkDestroyCommandPool(p->device, g->commands, NULL);
+    if (g->pool) vkDestroyDescriptorPool(p->device, g->pool, NULL);
+    if (g->pipeline_layout) vkDestroyPipelineLayout(p->device, g->pipeline_layout, NULL);
+    if (g->layout) vkDestroyDescriptorSetLayout(p->device, g->layout, NULL);
+    *g = (struct fel_probe_group){0};
+}
+
+static bool fel_probe_create_group(struct aimagereader_vk_stable *p,
+                                   struct mp_fel_bind_probe *probe,
+                                   struct vk_input *input, VkImageView target,
+                                   unsigned kind, struct fel_probe_group *g)
+{
+    VkCommandPoolCreateInfo commands = {
+        .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+        .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+        .queueFamilyIndex = p->queue_family,
+    };
+    if (!mp_fel_probe_live(probe, mp_time_ns()) ||
+        vkCreateCommandPool(p->device, &commands, NULL, &g->commands) != VK_SUCCESS)
+        return false;
+    VkCommandBufferAllocateInfo command = {
+        .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+        .commandPool = g->commands, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+        .commandBufferCount = 1,
+    };
+    if (!mp_fel_probe_live(probe, mp_time_ns()) ||
+        vkAllocateCommandBuffers(p->device, &command, &g->command) != VK_SUCCESS)
+        return false;
+    if (!kind)
+        return true;
+    VkDescriptorSetLayoutBinding bindings[2] = {0};
+    VkDescriptorPoolSize sizes[2] = {0};
+    VkDescriptorImageInfo images[2] = {0};
+    VkWriteDescriptorSet writes[2] = {0};
+    unsigned count = 0;
+    if (kind & 1) {
+        bindings[count] = (VkDescriptorSetLayoutBinding){
+            .binding = 0, .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+            .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+            .pImmutableSamplers = &p->sampler,
+        };
+        sizes[count] = (VkDescriptorPoolSize){
+            VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, p->sampler_descriptors,
+        };
+        images[count++] = (VkDescriptorImageInfo){
+            .sampler = p->sampler, .imageView = input->view,
+            .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+        };
+    }
+    if (kind & 2) {
+        bindings[count] = (VkDescriptorSetLayoutBinding){
+            .binding = 1, .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+        };
+        sizes[count] = (VkDescriptorPoolSize){VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1};
+        images[count++] = (VkDescriptorImageInfo){
+            .imageView = target, .imageLayout = VK_IMAGE_LAYOUT_GENERAL,
+        };
+    }
+    VkDescriptorSetLayoutCreateInfo layout = {
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+        .bindingCount = count, .pBindings = bindings,
+    };
+    if (!mp_fel_probe_live(probe, mp_time_ns()) ||
+        vkCreateDescriptorSetLayout(p->device, &layout, NULL, &g->layout) != VK_SUCCESS)
+        return false;
+    VkPipelineLayoutCreateInfo pipeline = {
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+        .setLayoutCount = 1, .pSetLayouts = &g->layout,
+    };
+    if (!mp_fel_probe_live(probe, mp_time_ns()) ||
+        vkCreatePipelineLayout(p->device, &pipeline, NULL, &g->pipeline_layout) != VK_SUCCESS)
+        return false;
+    VkDescriptorPoolCreateInfo pool = {
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+        .maxSets = 1, .poolSizeCount = count, .pPoolSizes = sizes,
+    };
+    if (!mp_fel_probe_live(probe, mp_time_ns()) ||
+        vkCreateDescriptorPool(p->device, &pool, NULL, &g->pool) != VK_SUCCESS)
+        return false;
+    VkDescriptorSetAllocateInfo set = {
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+        .descriptorPool = g->pool, .descriptorSetCount = 1, .pSetLayouts = &g->layout,
+    };
+    if (!mp_fel_probe_live(probe, mp_time_ns()) ||
+        vkAllocateDescriptorSets(p->device, &set, &g->set) != VK_SUCCESS)
+        return false;
+    for (unsigned i = 0; i < count; i++) {
+        writes[i] = (VkWriteDescriptorSet){
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstSet = g->set, .dstBinding = bindings[i].binding,
+            .descriptorCount = 1, .descriptorType = bindings[i].descriptorType,
+            .pImageInfo = &images[i],
+        };
+    }
+    vkUpdateDescriptorSets(p->device, count, writes, 0, NULL);
+    return mp_fel_probe_live(probe, mp_time_ns());
+}
+
+static bool fel_probe_measure_group(struct aimagereader_vk_stable *p,
+                                    struct mp_fel_bind_probe *probe,
+                                    struct fel_probe_group *g, unsigned kind,
+                                    int64_t cold_ns)
+{
+    static const char *const names[] = {"empty", "sampler-only", "storage-only", "combined"};
+    struct fel_latency_window bind = {0}, cpu = {0}, record = {0}, record_cpu = {0};
+    int64_t started = mp_time_ns();
+    int64_t deadline = MPMIN(probe->deadline, started + MP_FEL_PROBE_GROUP_NS);
+    unsigned warmup = 0;
+    bool ok = true, cpu_available = true;
+    for (unsigned i = 0; i < MP_FEL_PROBE_WARMUP + MP_FEL_PROBE_SAMPLES; i++) {
+        if (!mp_fel_probe_live(probe, mp_time_ns()) || mp_time_ns() >= deadline)
+            break;
+        int64_t r_cpu = mp_fel_thread_cpu_ns(), r_wall = mp_time_ns();
+        VkCommandBufferBeginInfo begin = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+        };
+        if (vkResetCommandBuffer(g->command, 0) != VK_SUCCESS ||
+            !mp_fel_probe_live(probe, mp_time_ns()) ||
+            vkBeginCommandBuffer(g->command, &begin) != VK_SUCCESS) {
+            ok = false;
+            break;
+        }
+        if (!mp_fel_probe_live(probe, mp_time_ns()))
+            break;
+        int64_t b_cpu = mp_fel_thread_cpu_ns(), b_wall = mp_time_ns();
+        if (kind)
+            vkCmdBindDescriptorSets(g->command, VK_PIPELINE_BIND_POINT_COMPUTE,
+                g->pipeline_layout, 0, 1, &g->set, 0, NULL);
+        int64_t b_elapsed = MPMAX(0, mp_time_ns() - b_wall);
+        int64_t b_cpu_end = mp_fel_thread_cpu_ns();
+        if (vkEndCommandBuffer(g->command) != VK_SUCCESS) {
+            ok = false;
+            break;
+        }
+        int64_t r_elapsed = MPMAX(0, mp_time_ns() - r_wall);
+        int64_t r_cpu_end = mp_fel_thread_cpu_ns();
+        cpu_available &= b_cpu > 0 && b_cpu_end >= b_cpu &&
+                         r_cpu > 0 && r_cpu_end >= r_cpu;
+        if (i < MP_FEL_PROBE_WARMUP) {
+            warmup++;
+        } else {
+            fel_latency_add(&bind, b_elapsed);
+            fel_latency_add(&record, r_elapsed);
+            if (cpu_available) {
+                fel_latency_add(&cpu, b_cpu_end - b_cpu);
+                fel_latency_add(&record_cpu, r_cpu_end - r_cpu);
+            }
+        }
+    }
+    uint64_t b[3], c[3], r[3], rc[3];
+    fel_latency_summary(&bind, b); fel_latency_summary(&cpu, c);
+    fel_latency_summary(&record, r); fel_latency_summary(&record_cpu, rc);
+    mp_info(p->log, "WebHTV FEL bind probe: id=%" PRIu64 " group=%s stage=record-only "
+        "pipeline=none warmup=%u samples=%u complete=%d cold-us=%" PRId64 " "
+        "bind-us=%" PRIu64 "/%" PRIu64 "/%" PRIu64 " bind-cpu-us=%" PRIu64 "/%" PRIu64 "/%" PRIu64 " "
+        "record-us=%" PRIu64 "/%" PRIu64 "/%" PRIu64 " record-cpu-us=%" PRIu64 "/%" PRIu64 "/%" PRIu64 " "
+        "cpu-available=%d statistic=p50/p95/max probe-submits=0 gpu-time=unmeasured.\n",
+        probe->serial, names[kind], warmup, bind.count,
+        ok && bind.count == MP_FEL_PROBE_SAMPLES, cold_ns / 1000,
+        b[0], b[1], b[2], c[0], c[1], c[2], r[0], r[1], r[2], rc[0], rc[1], rc[2], cpu_available);
+    return ok && bind.count == MP_FEL_PROBE_SAMPLES;
+}
+
+static bool fel_run_bind_probe(struct aimagereader_vk_stable *p,
+                               struct vk_input *input, struct mp_image *frame, int acquire)
+{
+    struct vo *vo = p->mapper->owner->ra_ctx->vo;
+    struct mp_fel_bind_probe *probe = &vo->fel_bind_probe;
+    if (!mp_fel_probe_claim(probe))
+        return false;
+    unsigned char *lease = frame->android_fel_staging ? frame->android_fel_staging->data : NULL;
+    mp_android_fel_staging_begin_probe(lease);
+    vo->extra.wakeup_cb(vo->extra.wakeup_ctx);
+    int64_t started = mp_time_ns();
+    int64_t handshake = MPMIN(probe->deadline, started + INT64_C(2000000000));
+    const char *reason = "pause-handshake";
+    unsigned drains = 0, complete = 0;
+    struct fel_probe_target target = {0};
+    struct fel_probe_group group = {0};
+    while (mp_fel_probe_state(probe) == MP_FEL_PROBE_QUIESCING &&
+           mp_fel_probe_live(probe, mp_time_ns()) && mp_time_ns() < handshake)
+        mp_sleep_ns(1000000);
+    if (mp_fel_probe_state(probe) != MP_FEL_PROBE_RUNNING ||
+        !mp_fel_probe_live(probe, mp_time_ns()))
+        goto done;
+    reason = "source-acquire";
+    int64_t acquire_deadline = MPMIN(probe->deadline, mp_time_ns() + INT64_C(2000000000));
+    int fence_state;
+    while ((fence_state = fel_probe_acquire_fence(acquire)) == 1 &&
+           mp_fel_probe_live(probe, mp_time_ns()) && mp_time_ns() < acquire_deadline)
+        mp_sleep_ns(1000000);
+    if ((fence_state != 0 && fence_state != 2) || !mp_fel_probe_live(probe, mp_time_ns()))
+        goto done;
+    reason = "queue-drain";
+    if (!fel_probe_drain_queues(p, probe, &drains))
+        goto done;
+    reason = "target-allocation-or-budget";
+    int64_t target_started = mp_time_ns();
+    if (!fel_probe_create_target(p, probe, &target))
+        goto done;
+    VkPhysicalDeviceProperties props;
+    vkGetPhysicalDeviceProperties(p->vk->phys_device, &props);
+    mp_info(p->log, "WebHTV FEL bind probe: id=%" PRIu64 " begin gpu=%s vendor=%u device=%u "
+        "driver=%u api=%u queue=%u source-format=%u external-format=0x%" PRIx64 " "
+        "target-format=%u size=%dx%d target-usage=storage+sampled target-bytes=%" PRIu64 " "
+        "target-cold-us=%" PRId64 " source=held-AImage acquire=signalled app-queues=drained "
+        "drain-submits=%u probe-submits=0 pixel-access=none.\n",
+        probe->serial, props.deviceName, props.vendorID, props.deviceID, props.driverVersion,
+        props.apiVersion, p->queue_family, p->source_format, p->external_format,
+        p->output_format, p->width, p->height, (uint64_t)target.bytes,
+        (mp_time_ns() - target_started) / 1000, drains);
+    reason = "group-incomplete";
+    for (unsigned kind = 0; kind < 4 && mp_fel_probe_live(probe, mp_time_ns()); kind++) {
+        int64_t cold = mp_time_ns();
+        if (!fel_probe_create_group(p, probe, input, target.view, kind, &group))
+            break;
+        bool measured = fel_probe_measure_group(p, probe, &group, kind, mp_time_ns() - cold);
+        fel_probe_destroy_group(p, &group);
+        complete += measured;
+        if (!measured)
+            break;
+    }
+    if (complete == 4)
+        reason = "completed";
+done:
+    fel_probe_destroy_group(p, &group);
+    fel_probe_destroy_target(p, &target);
+    int state = mp_time_ns() >= probe->deadline ? MP_FEL_PROBE_TIMED_OUT :
+        __atomic_load_n(&probe->cancel, __ATOMIC_ACQUIRE) ? MP_FEL_PROBE_CANCELLED :
+        complete == 4 ? MP_FEL_PROBE_DONE : MP_FEL_PROBE_FAILED;
+    mp_info(p->log, "WebHTV FEL bind probe: id=%" PRIu64 " end status=%s reason=%s "
+        "groups=%u/4 wall-ms=%" PRId64 " pending-drains=%u probe-submits=0 source=still-held "
+        "resume=current-user-pause-intent.\n", probe->serial, mp_fel_probe_name(state), reason,
+        complete, (mp_time_ns() - started) / 1000000, p->fel_probe_drain_count);
+    mp_android_fel_staging_end_probe(lease);
+    __atomic_store_n(&probe->state, state, __ATOMIC_RELEASE);
+    vo->extra.wakeup_cb(vo->extra.wakeup_ctx);
+    return true;
+}
