+static bool prepare_conversion(struct aimagereader_vk_stable *p,
+                                struct vk_output *output, struct vk_input *input,
+                                const AHardwareBuffer_Desc *desc,
+                                const AImageCropRect *crop)
+{
+    // The caller has already completed this output's copy fence and reclaimed
+    // its render semaphore. Submission always uses this frame's sync objects.
+    if (output->pending)
+        return false;
+    output->active_command = VK_NULL_HANDLE;
+    if (p->android_fel && input->initialized && !input->removed && output->written) {
+        bool hit = false;
+        struct vk_recording *record = p->recording_cache_disabled ? NULL :
+            select_recording(p, output, input, desc, crop, &hit);
+        if (hit) {
+            // Both views and their lifetimes match. The immutable sampler,
+            // YCbCr conversion and layouts live as long as this recording pool;
+            // imageLayout is fixed per binding. Only descriptor writes can be
+            // skipped: current pixels/UV, ownership and sync need fresh commands.
+            record->valid = false;
+            if (!record_conversion(p, output, input, desc, crop, record))
+                return false;
+            record->valid = true;
+            p->recording_hits++;
+            if (!p->push_descriptors)
+                p->descriptor_content_hits++;
+            record->last_used = ++p->recording_serial;
+            output->active_command = record->command;
+            output->fel_query_recorded = record->timestamps;
+            return true;
+        }
+        p->recording_misses++;
+        if (record) {
+            record->valid = false;
+            if (allocate_recording(p, record)) {
+                update_conversion_descriptor(p, VK_NULL_HANDLE, record->descriptor, input, output, true);
+                if (!record_conversion(p, output, input, desc, crop, record))
+                    return false;
+                record->input = input;
+                record->output = output;
+                record->input_view = input->view;
+                record->output_view = output->view;
+                record->crop = *crop;
+                record->width = desc->width;
+                record->height = desc->height;
+                record->timestamps = output->fel_query_recorded;
+                record->last_used = ++p->recording_serial;
+                record->valid = true;
+                output->active_command = record->command;
+                return true;
+            }
+        }
+        p->recording_fallbacks++;
+    } else if (p->android_fel) {
+        p->recording_cold++;
+    }
+    update_conversion_descriptor(p, VK_NULL_HANDLE, output->descriptor, input, output, false);
+    return record_conversion(p, output, input, desc, crop, NULL);
 }

