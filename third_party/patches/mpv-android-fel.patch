+static bool recording_pending(const struct vk_recording *record)
+{
+    return record->command && record->output && record->output->pending &&
+           record->output->active_command == record->command;
+}
+
+static bool recording_matches(const struct vk_recording *record,
+                               struct vk_output *output, struct vk_input *input,
+                               const AHardwareBuffer_Desc *desc,
+                               const AImageCropRect *crop, bool timestamps)
+{
+    return record->valid && record->input == input && record->output == output &&
+           record->input_view == input->view && record->output_view == output->view &&
+           record->width == desc->width && record->height == desc->height &&
+           record->crop.left == crop->left && record->crop.top == crop->top &&
+           record->crop.right == crop->right && record->crop.bottom == crop->bottom &&
+           record->timestamps == timestamps;
+}
+
+static struct vk_recording *select_recording(struct aimagereader_vk_stable *p,
+                                             struct vk_output *output,
+                                             struct vk_input *input,
+                                             const AHardwareBuffer_Desc *desc,
+                                             const AImageCropRect *crop, bool *hit)
+{
+    *hit = false;
+    struct vk_recording *oldest = NULL;
+    bool timestamps = p->fel_query_pool && !p->fel_query_failed;
+    for (int n = 0; n < p->num_recordings; n++) {
+        struct vk_recording *record = &p->recordings[n];
+        if (recording_pending(record))
+            continue;
+        if (recording_matches(record, output, input, desc, crop, timestamps)) {
+            *hit = true;
+            return record;
+        }
+        if (!oldest || (!record->valid && oldest->valid) ||
+            (record->valid == oldest->valid && record->last_used < oldest->last_used))
+            oldest = record;
+    }
+    if ((!oldest || oldest->valid) && p->num_recordings < FEL_RECORD_CACHE_SIZE)
+        return &p->recordings[p->num_recordings++];
+    if (oldest && oldest->valid)
+        p->recording_evictions++;
+    return oldest; // NULL means all entries are in flight: use the original path.
+}
+
+static bool allocate_recording(struct aimagereader_vk_stable *p,
+                                struct vk_recording *record)
+{
+    if (!p->push_descriptors && !p->recording_pool) {
+        VkDescriptorPoolSize sizes[] = {
+            {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+             FEL_RECORD_CACHE_SIZE * p->sampler_descriptors},
+            {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, FEL_RECORD_CACHE_SIZE},
+        };
+        VkDescriptorPoolCreateInfo info = {
+            .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+            .maxSets = FEL_RECORD_CACHE_SIZE,
+            .poolSizeCount = MP_ARRAY_SIZE(sizes), .pPoolSizes = sizes,
+        };
+        VkDescriptorPool pool = VK_NULL_HANDLE;
+        if (vkCreateDescriptorPool(p->device, &info, NULL, &pool) != VK_SUCCESS)
+            goto unavailable;
+        p->recording_pool = pool;
+    }
+    if (!p->push_descriptors && !record->descriptor) {
+        VkDescriptorSetAllocateInfo info = {
+            .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+            .descriptorPool = p->recording_pool, .descriptorSetCount = 1,
+            .pSetLayouts = &p->descriptor_layout,
+        };
+        VkDescriptorSet descriptor = VK_NULL_HANDLE;
+        if (vkAllocateDescriptorSets(p->device, &info, &descriptor) != VK_SUCCESS)
+            goto unavailable;
+        record->descriptor = descriptor;
+    }
+    if (!record->command) {
+        VkCommandBufferAllocateInfo info = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+            .commandPool = p->command_pool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+            .commandBufferCount = 1,
+        };
+        VkCommandBuffer command = VK_NULL_HANDLE;
+        if (vkAllocateCommandBuffers(p->device, &info, &command) != VK_SUCCESS)
+            goto unavailable;
+        record->command = command;
+    }
+    return true;
+
+unavailable:
+    // Optional optimization only. Retain any partially allocated metadata for
+    // teardown; do not retry a failing allocation on every frame or fail FEL.
+    p->recording_cache_disabled = true;
+    return false;
+}
+
+static void update_conversion_descriptor(struct aimagereader_vk_stable *p,
+                                         VkCommandBuffer command,
+                                         VkDescriptorSet descriptor,
+                                         struct vk_input *input,
+                                         struct vk_output *output, bool both)
+{
+    if (p->push_descriptors && !command)
+        return; // Push only while recording; no vkUpdateDescriptorSets on this layout.
+    VkDescriptorImageInfo images[] = {
+        {.imageView = input->view, .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+        {.imageView = output->view, .imageLayout = VK_IMAGE_LAYOUT_GENERAL},
+    };
+    VkWriteDescriptorSet writes[] = {
+        {
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstSet = descriptor, .dstBinding = 0, .descriptorCount = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+            .pImageInfo = &images[0],
+        }, {
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstSet = descriptor, .dstBinding = 1, .descriptorCount = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            .pImageInfo = &images[1],
+        },
+    };
+    struct fel_api_clock clock = fel_api_begin(p);
+    if (p->push_descriptors) {
+        // Both bindings, including the immutable YCbCr sampler, start undefined
+        // at each vkBeginCommandBuffer. Always push this frame's exact views.
+        p->CmdPushDescriptorSetKHR(command, VK_PIPELINE_BIND_POINT_COMPUTE,
+                                  p->pipeline_layout, 0, MP_ARRAY_SIZE(writes), writes);
+        fel_api_end(p, FEL_API_PUSH_DESCRIPTORS, clock);
+    } else {
+        vkUpdateDescriptorSets(p->device, both ? 2 : 1, writes, 0, NULL);
+        fel_api_end(p, FEL_API_DESCRIPTOR, clock);
+        if (p->android_fel)
+            p->descriptor_writes++;
+    }
+}
