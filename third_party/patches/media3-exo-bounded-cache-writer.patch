@@ -104,0 +105,47 @@ public final class CacheWriterTest {
+  @Test
+  public void cache_dataSourceIgnoresBoundedLength_stopsAtRequestedLength() throws Exception {
+    FakeDataSet fakeDataSet = new FakeDataSet().setRandomData("test_data", 100);
+    FakeDataSource delegate = new FakeDataSource(fakeDataSet);
+    DataSource dataSource =
+        new DataSource() {
+          @Override
+          public void addTransferListener(TransferListener transferListener) {
+            delegate.addTransferListener(transferListener);
+          }
+
+          @Override
+          public long open(DataSpec dataSpec) throws IOException {
+            return delegate.open(dataSpec.buildUpon().setLength(C.LENGTH_UNSET).build());
+          }
+
+          @Override
+          public int read(byte[] buffer, int offset, int length) throws IOException {
+            return delegate.read(buffer, offset, length);
+          }
+
+          @Override
+          public Uri getUri() {
+            return delegate.getUri();
+          }
+
+          @Override
+          public void close() throws IOException {
+            delegate.close();
+          }
+        };
+    DataSpec dataSpec = new DataSpec(Uri.parse("test_data"), /* position= */ 10, /* length= */ 20);
+    CachingCounters counters = new CachingCounters();
+
+    CacheWriter cacheWriter =
+        new CacheWriter(
+            new CacheDataSource(cache, dataSource),
+            dataSpec,
+            /* temporaryBuffer= */ new byte[7],
+            counters);
+    cacheWriter.cache();
+
+    counters.assertValues(0, 20, 20);
+    assertThat(cache.getCachedBytes("test_data", /* position= */ 0, /* length= */ 100))
+        .isEqualTo(20);
+  }
