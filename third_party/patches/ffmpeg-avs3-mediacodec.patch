+#if CONFIG_AVS3_MEDIACODEC_DECODER
+static int avs3_set_extradata(AVCodecContext *avctx, FFAMediaFormat *format)
+{
+    uint8_t *header = avctx->extradata;
+    int size = avctx->extradata_size;
+
+    /* TS/raw inputs may carry their sequence header in the first access unit. */
+    if (!size)
+        return 0;
+    if (!header || size < 6)
+        return AVERROR_INVALIDDATA;
+
+    /* Avs3DecoderConfigurationRecord: version, length, sequence, library flags.
+     * MediaCodec consumes the sequence bytes, not this MP4 container record. */
+    if (header[0] == 1) {
+        int sequence_size = AV_RB16(header + 1);
+        if (sequence_size < 6 || sequence_size > size - 4)
+            return AVERROR_INVALIDDATA;
+        header += 3;
+        size = sequence_size;
+    }
+    if (AV_RB32(header) != 0x000001B0)
+        return AVERROR_INVALIDDATA;
+
+    /* Android has no standardized AVS3 CodecProfileLevel values. Preserve the
+     * bitstream profile/precision and let the hardware validate its support. */
+    ff_AMediaFormat_setBuffer(format, "csd-0", header, size);
+    av_log(avctx, AV_LOG_INFO,
+           "WebHTV AVS3 MediaCodec config: profile=0x%02x level=0x%02x csd=%d\n",
+           header[4], header[5], size);
+    return 0;
+}
+#endif
+
 static const AVDOVIDecoderConfigurationRecord *
 mediacodec_get_dovi_config(AVCodecContext *avctx)
 {
