+package androidx.media3.common.text;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import android.text.TextPaint;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+/** Tests for {@link LetterSpacingSpan}. */
+@RunWith(AndroidJUnit4.class)
+public class LetterSpacingSpanTest {
+
+  @Test
+  public void pixelSpacingUsesCurrentTextSize() {
+    TextPaint textPaint = new TextPaint();
+    textPaint.setTextSize(10f);
+
+    new LetterSpacingSpan(2f).updateMeasureState(textPaint);
+
+    assertThat(textPaint.getLetterSpacing()).isWithin(0.0001f).of(0.2f);
+  }
+
+  @Test
+  public void negativePixelSpacingIsPreserved() {
+    TextPaint textPaint = new TextPaint();
+    textPaint.setTextSize(10f);
+
+    new LetterSpacingSpan(-2f).updateDrawState(textPaint);
+
+    assertThat(textPaint.getLetterSpacing()).isWithin(0.0001f).of(-0.2f);
+  }
+
+  @Test
+  public void emSpacingIsAppliedDirectly() {
+    TextPaint textPaint = new TextPaint();
+    textPaint.setTextSize(10f);
+
+    LetterSpacingSpan.createFromEm(0.15f).updateMeasureState(textPaint);
+
+    assertThat(textPaint.getLetterSpacing()).isWithin(0.0001f).of(0.15f);
+  }
+
+  @Test
+  public void bundleRoundTripPreservesPixelAndEmSpacing() {
+    TextPaint pixelPaint = new TextPaint();
+    pixelPaint.setTextSize(8f);
+    TextPaint emPaint = new TextPaint();
+
+    LetterSpacingSpan.fromBundle(new LetterSpacingSpan(2f).toBundle())
+        .updateMeasureState(pixelPaint);
+    LetterSpacingSpan.fromBundle(LetterSpacingSpan.createFromEm(0.25f).toBundle())
+        .updateMeasureState(emPaint);
+
+    assertThat(pixelPaint.getLetterSpacing()).isWithin(0.0001f).of(0.25f);
+    assertThat(emPaint.getLetterSpacing()).isWithin(0.0001f).of(0.25f);
+  }
+}
