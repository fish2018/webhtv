+  @RequiresNonNull("#1.output")
+  private void appendDolbyVisionBlockAdditionalData(Track track) {
+    byte[] blockAdditionalData = track.pendingDolbyVisionBlockAdditionalData;
+    track.pendingDolbyVisionBlockAdditionalData = null;
+    if (blockAdditionalData == null) {
+      return;
+    }
+    if (blockSampleCount != 1) {
+      Log.w(TAG, "Skipping Dolby Vision BlockAdditional data in a laced block.");
+      return;
+    }
+    nalStartCode.setPosition(0);
+    track.output.sampleData(nalStartCode, NalUnitUtil.NAL_START_CODE.length);
+    ParsableByteArray rpuData = new ParsableByteArray(blockAdditionalData);
+    track.output.sampleData(rpuData, blockAdditionalData.length);
+    blockSampleSizes[0] += NalUnitUtil.NAL_START_CODE.length + blockAdditionalData.length;
+  }
