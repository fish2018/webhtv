+static int64_t android_monotonic_time_ns(void)
+{
+    struct timespec time;
+    if (clock_gettime(CLOCK_MONOTONIC, &time) < 0 || time.tv_sec < 0 ||
+        time.tv_sec > INT64_MAX / MP_TIME_S_TO_NS(1))
+        return 0;
+
+    return (int64_t)time.tv_sec * MP_TIME_S_TO_NS(1) + time.tv_nsec;
+}

