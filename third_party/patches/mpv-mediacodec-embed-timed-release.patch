+static bool schedule_image(struct vo *vo, struct mp_image *image, int64_t pts,
+                           int64_t duration, bool allow_defer)
+{
+    struct priv *p = vo->priv;
+    AVMediaCodecBuffer *buffer = (AVMediaCodecBuffer *)image->planes[3];
+    int64_t submit_start = mp_time_ns();
+    int64_t lead = pts > 0 ? pts - submit_start : 0;
+    int result;
+    bool timed = false;
+
+    if (allow_defer && lead > MEDIACODEC_QUEUE_OFFSET_NS)
+        return false;
+
+    if (lead > 0) {
+        // mpv may use CLOCK_MONOTONIC_RAW. Convert only the relative lead to
+        // the CLOCK_MONOTONIC epoch required by MediaCodec.
+        int64_t monotonic_now = android_monotonic_time_ns();
+        if (monotonic_now <= 0 || lead > INT64_MAX - monotonic_now) {
+            if (allow_defer)
+                return false;
+            result = av_mediacodec_release_buffer(buffer, 1);
+        } else {
+            result = av_mediacodec_render_buffer_at_time(buffer,
+                                                         monotonic_now + lead);
+            timed = true;
+        }
+    } else {
+        result = av_mediacodec_release_buffer(buffer, 1);
+    }
+
+    int64_t release_elapsed = MPMAX(mp_time_ns() - submit_start, 0);
+    int64_t frame_budget = duration > 0
+        ? duration : MP_TIME_US_TO_NS(16667);
+    if (frame_budget <= 0 || frame_budget > MP_TIME_S_TO_NS(10))
+        frame_budget = MP_TIME_US_TO_NS(16667);
+
+    int64_t submit_gap = p->last_submit_start > 0
+        ? submit_start - p->last_submit_start : 0;
+    p->last_submit_start = submit_start;
+    if (submit_gap > 0)
+        p->submit_gap_max = MPMAX(p->submit_gap_max, submit_gap);
+    if (submit_gap > frame_budget * 2)
+        p->submit_gap_stalls++;
+
+    p->submitted_frames++;
+    p->release_window_calls++;
+    p->release_total += release_elapsed;
+    p->release_max = MPMAX(p->release_max, release_elapsed);
+    if (release_elapsed > frame_budget)
+        p->release_stalls++;
+    if (timed) {
+        p->timed_frames++;
+        p->timed_window_frames++;
+        p->timed_lead_total += lead;
+        p->timed_lead_min = MPMIN(p->timed_lead_min, lead);
+        p->timed_lead_max = MPMAX(p->timed_lead_max, lead);
+    } else {
+        p->immediate_frames++;
+        if (pts > 0 && lead <= 0) {
+            p->late_frames++;
+            p->late_window_frames++;
+            p->late_total += -lead;
+            p->late_max = MPMAX(p->late_max, -lead);
+        }
+    }
+
+    if (result < 0)
+        report_backend_error(vo, "video surface");
+
+    if (p->submitted_frames % TIMING_LOG_INTERVAL == 0) {
+        int64_t average_lead = p->timed_window_frames > 0
+            ? p->timed_lead_total / p->timed_window_frames : 0;
+        int64_t minimum_lead = p->timed_window_frames > 0
+            ? p->timed_lead_min : 0;
+        MP_WARN(vo, "MediaCodec output scheduling: mode=early-timestamped "
+                    "submitted=%llu timed=%llu immediate=%llu late=%llu "
+                    "lead=%lld/%lld/%lld us late-by=%lld/%lld us "
+                    "release=%lld/%lld us gap-max=%lld us "
+                    "release-stalls=%llu gap-stalls=%llu.\n",
+                (unsigned long long)p->submitted_frames,
+                (unsigned long long)p->timed_frames,
+                (unsigned long long)p->immediate_frames,
+                (unsigned long long)p->late_frames,
+                (long long)(minimum_lead / 1000),
+                (long long)(average_lead / 1000),
+                (long long)(p->timed_lead_max / 1000),
+                (long long)(p->late_window_frames > 0
+                    ? p->late_total / p->late_window_frames : 0) / 1000,
+                (long long)(p->late_max / 1000),
+                (long long)(p->release_window_calls > 0
+                    ? p->release_total / p->release_window_calls : 0) / 1000,
+                (long long)(p->release_max / 1000),
+                (long long)(p->submit_gap_max / 1000),
+                (unsigned long long)p->release_stalls,
+                (unsigned long long)p->submit_gap_stalls);
+        p->timed_lead_total = 0;
+        p->timed_lead_min = INT64_MAX;
+        p->timed_lead_max = 0;
+        p->release_total = 0;
+        p->release_max = 0;
+        p->late_total = 0;
+        p->late_max = 0;
+        p->late_window_frames = 0;
+        p->submit_gap_max = 0;
+        p->release_stalls = 0;
+        p->submit_gap_stalls = 0;
+        p->timed_window_frames = 0;
+        p->release_window_calls = 0;
+    }
+    return true;
+}
