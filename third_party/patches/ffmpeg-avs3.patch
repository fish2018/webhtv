+static int libuavs3d_check_sequence_header(AVCodecContext *avctx,
+                                         const uint8_t *header, int size)
+{
+    if (size < 6 || UAVS3D_CHECK_START_CODE(header, AVS3_SEQ_START_CODE))
+        return AVERROR_INVALIDDATA;
+
+    uavs3d_context *h = avctx->priv_data;
+    if (header[4] == 0x32) {
+        if (!h->hpm) {
+            h->hpm = webhtv_hpm_create();
+            if (!h->hpm)
+                return AVERROR(ENOMEM);
+            if (h->dec_handle) {
+                uavs3d_delete(h->dec_handle);
+                h->dec_handle = NULL;
+            }
+            h->got_seqhdr = 0;
+            av_log(avctx, AV_LOG_INFO, "AVS3 software backend: %s\n", webhtv_hpm_version());
+        }
+        return 0;
+    }
+    if (h->hpm)
+        return AVERROR_PATCHWELCOME;
+    // uavs3d's release build coerces unknown profiles to baseline. Reject the
+    // original byte before parsing either extradata or an in-band sequence.
+    if (header[4] != 0x20 && header[4] != 0x22) {
+        av_log(avctx, AV_LOG_ERROR,
+               "Unsupported AVS3 profile 0x%02x; libuavs3d supports only 0x20/0x22.\n",
+               header[4]);
+        return AVERROR_PATCHWELCOME;
+    }
+    return 0;
+}
