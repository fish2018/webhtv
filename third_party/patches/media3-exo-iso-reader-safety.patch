+package androidx.media3.datasource;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import android.net.Uri;
+import androidx.media3.common.C;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+/** Unit tests for {@link IsoDataReader}. */
+@RunWith(AndroidJUnit4.class)
+public final class IsoDataReaderTest {
+
+  private static final int SECTOR_SIZE = 2048;
+  private static final Uri URI = Uri.parse("test://iso");
+
+  @Test
+  public void read_zeroLength_returnsZeroWithoutCreatingDataSource() throws Exception {
+    AtomicInteger createCount = new AtomicInteger();
+    IsoDataReader reader =
+        new IsoDataReader(
+            () -> {
+              createCount.incrementAndGet();
+              return new ByteArrayDataSource(new byte[SECTOR_SIZE]);
+            },
+            URI);
+
+    assertThat(reader.read(0, new byte[0], 0, 0)).isEqualTo(0);
+    assertThat(createCount.get()).isEqualTo(0);
+  }
+
+  @Test
+  public void prefetchRange_invalidOrTooLarge_doesNotCreateDataSource() {
+    AtomicInteger createCount = new AtomicInteger();
+    IsoDataReader reader =
+        new IsoDataReader(
+            () -> {
+              createCount.incrementAndGet();
+              return new ByteArrayDataSource(new byte[SECTOR_SIZE]);
+            },
+            URI);
+
+    reader.prefetchRange(-1, SECTOR_SIZE);
+    reader.prefetchRange(SECTOR_SIZE, SECTOR_SIZE);
+    reader.prefetchRange(SECTOR_SIZE * 2L, SECTOR_SIZE);
+    reader.prefetchRange(0, (8192L + 1) * SECTOR_SIZE);
+
+    assertThat(createCount.get()).isEqualTo(0);
+  }
+
+  @Test
+  public void read_normalRangeAcrossSectorBoundary_returnsExpectedBytes() throws Exception {
+    byte[] input = new byte[SECTOR_SIZE * 2];
+    for (int i = 0; i < input.length; i++) {
+      input[i] = (byte) i;
+    }
+    IsoDataReader reader = new IsoDataReader(() -> new ByteArrayDataSource(input), URI);
+    byte[] output = new byte[16];
+
+    assertThat(reader.read(SECTOR_SIZE - 8, output, 0, output.length)).isEqualTo(output.length);
+    assertThat(output)
+        .isEqualTo(Arrays.copyOfRange(input, SECTOR_SIZE - 8, SECTOR_SIZE + 8));
+  }
+
+  @Test
+  public void read_openThrows_closesDataSource() {
+    TrackingDataSource dataSource = new TrackingDataSource(/* failOnOpen= */ true);
+    IsoDataReader reader = new IsoDataReader(() -> dataSource, URI);
+
+    assertThrows(IOException.class, () -> reader.read(0, new byte[1], 0, 1));
+    assertThat(dataSource.closed).isTrue();
+  }
+
+  @Test
+  public void read_endOfInput_closesDataSource() {
+    TrackingDataSource dataSource = new TrackingDataSource(/* failOnOpen= */ false);
+    IsoDataReader reader = new IsoDataReader(() -> dataSource, URI);
+
+    assertThrows(IOException.class, () -> reader.read(0, new byte[1], 0, 1));
+    assertThat(dataSource.closed).isTrue();
+  }
+
+  private static final class TrackingDataSource implements DataSource {
+    private final boolean failOnOpen;
+    private boolean closed;
+
+    private TrackingDataSource(boolean failOnOpen) {
+      this.failOnOpen = failOnOpen;
+    }
+
+    @Override
+    public void addTransferListener(TransferListener transferListener) {}
+
+    @Override
+    public long open(DataSpec dataSpec) throws IOException {
+      if (failOnOpen) {
+        throw new IOException("open failed");
+      }
+      return C.LENGTH_UNSET;
+    }
+
+    @Override
+    public int read(byte[] buffer, int offset, int length) {
+      return C.RESULT_END_OF_INPUT;
+    }
+
+    @Override
+    public Uri getUri() {
+      return URI;
+    }
+
+    @Override
+    public void close() {
+      closed = true;
+    }
+  }
+}
