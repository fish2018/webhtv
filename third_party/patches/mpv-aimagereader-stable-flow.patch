+static uint64_t get_image_sequence(struct priv_owner *p)
+{
+    mp_mutex_lock(&p->image_lock);
+    uint64_t sequence = p->image_sequence;
+    mp_mutex_unlock(&p->image_lock);
+    return sequence;
+}
+
+static bool wait_for_image_signal(struct priv_owner *p, uint64_t *sequence,
+                                  int64_t deadline)
+{
+    mp_mutex_lock(&p->image_lock);
+    while (p->image_sequence == *sequence && mp_time_ns() < deadline) {
+        if (mp_cond_timedwait_until(&p->image_cond, &p->image_lock, deadline))
+            break;
+    }
+    bool changed = p->image_sequence != *sequence;
+    *sequence = p->image_sequence;
+    mp_mutex_unlock(&p->image_lock);
+    return changed;
+}
