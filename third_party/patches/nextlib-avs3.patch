+
+function buildUavs3d() {
+  # Apply only this video wrapper correction, preserving the pinned AV3A source.
+  if ! patch -d "$FFMPEG_DIR" -p1 -R --dry-run < "$WEBHTV_ROOT/third_party/patches/ffmpeg-avs3.patch" > /dev/null 2>&1; then
+    patch -d "$FFMPEG_DIR" -p1 --forward < "$WEBHTV_ROOT/third_party/patches/ffmpeg-avs3.patch"
+  fi
+  for ABI in $ANDROID_ABIS; do
+    bash "$WEBHTV_ROOT/scripts/build_avs3_native.sh" \
+      --abi "$ABI" --ndk "$ANDROID_NDK_HOME" \
+      --prefix "$BUILD_DIR/external/$ABI" \
+      --work-dir "$BUILD_DIR/uavs3d/$ABI" --jobs "$JOBS"
+  done
+  mkdir -p "$BASE_DIR/../media3ext/src/main/assets/licenses"
+  cp "$WEBHTV_ROOT/third_party/avs3-hpm/LICENSE.HPM" "$BASE_DIR/../media3ext/src/main/assets/licenses/hpm-avs3.txt"
+  cp "$BUILD_DIR/external/arm64-v8a/share/licenses/hpm-avs3/SSE2NEON" "$BASE_DIR/../media3ext/src/main/assets/licenses/sse2neon.txt"
 }
 
